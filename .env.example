# Biddaloy environment variables
# Copy this to .env and fill in real values.

# Database (PostgreSQL connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biddaloy

# TLS to Postgres — see server/src/db-ssl.ts and the README's "Data
# protection" section. REQUIRED (must be exactly "true") when
# NODE_ENV=production; the app refuses to boot otherwise. Optional outside
# production, since a local docker-compose Postgres has no TLS to negotiate.
# DB_SSL=true
# Only set this for a managed Postgres with a self-signed cert you trust
# out-of-band — it disables certificate verification and logs a boot
# warning every time it's set.
# DB_SSL_REJECT_UNAUTHORIZED=false

# docker-compose only: builds the DATABASE_URL above for the `db` and `app`
# services. Not read directly by the Nest app.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=biddaloy

# Application
# NODE_ENV must be one of: development, test, production
NODE_ENV=production
PORT=3000

# CORS: comma-separated allowlist of origins allowed to make credentialed
# cross-origin requests (e.g. https://app.example.com,https://admin.example.com).
# Unset defaults to http://localhost:5173 outside production, and to no
# cross-origin access at all in production — set this once a client SPA is
# deployed to its own domain/CDN instead of being served same-origin.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Authentication
# JWT_SECRET must be at least 32 characters — this placeholder is intentionally
# too short so the app refuses to boot until you set a real value.
JWT_SECRET=replace-me

# docker-compose only: TLS via the bundled nginx + certbot (see README's
# "Docker Deployment" section). Not read directly by the Nest app.
# APP_DOMAIN must have a DNS A/AAAA record pointing at this host for Let's
# Encrypt's HTTP-01 challenge to succeed.
APP_DOMAIN=localhost
LETSENCRYPT_EMAIL=admin@example.com

# Optional: custom app settings
# APP_NAME=biddaloy
# LOG_LEVEL=debug

# Seed admin password (used by "yarn seed")
# SEED_ADMIN_PASSWORD=change-me-admin-password-123

# TypeORM: set to "true" to auto-sync schema from entities (dev only — never use in prod)
# DB_SYNCHRONIZE=false

# Destructive operations: set to "true" to confirm db:clear / db:reset
# DB_DESTROY_CONFIRM=false

# Communications (SMS/WhatsApp/Email) — see server/src/modules/communications
# Job queue backing the communications module. Prefer 127.0.0.1 over
# "localhost": docker-compose binds redis to the IPv4 loopback, and on a
# dual-stack host "localhost" often resolves to ::1 first, giving ECONNREFUSED.
# REDIS_URL=redis://127.0.0.1:6379

# SMS: which gateway is active — "greenweb" or "mimsms"
# SMS_PROVIDER=greenweb
# GREENWEB_API_KEY=change-me
# MIMSMS_API_KEY=change-me
# MIMSMS_SENDER_ID=change-me

# WhatsApp: Meta Business Cloud API
# WHATSAPP_ACCESS_TOKEN=change-me
# WHATSAPP_PHONE_NUMBER_ID=change-me

# Email: plain SMTP (works with SendGrid's SMTP relay too)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=change-me
# SMTP_PASSWORD=change-me
# SMTP_FROM=no-reply@example.com

# Per-tenant settings encryption (server/src/modules/schools/settings) —
# AES-256-GCM key for schools.settings secrets (WhatsApp/email/SMS
# credentials a school configures for itself). Base64, 32 bytes.
# Required in production; optional in dev/test. Left commented out
# deliberately — even a throwaway value here is real key material a
# secret scanner can't tell apart from a live one, so it's generated
# locally instead of committed. Without it, saving a tenant secret in dev
# throws "Settings encryption is not configured"; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SETTINGS_ENCRYPTION_KEY=change-me
# A key rotation still in its grace window — see EncryptionService's class
# comment for the full procedure. Comma-separated for more than one.
# SETTINGS_ENCRYPTION_KEY_PREVIOUS=
