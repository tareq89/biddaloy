# SchoolManager environment variables
# Copy this to .env and fill in real values.

# Database (PostgreSQL connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biddaloy

# TLS to Postgres — see server/src/db-ssl.ts and the README's "Data
# protection" section. REQUIRED (must be exactly "true") when
# NODE_ENV=production; the app refuses to boot otherwise. Optional outside
# production, since a local docker-compose Postgres has no TLS to negotiate.
# DB_SSL=true
# Only set this for a managed Postgres with a self-signed cert you trust
# out-of-band — it disables certificate verification and logs a boot
# warning every time it's set.
# DB_SSL_REJECT_UNAUTHORIZED=false

# docker-compose only: builds the DATABASE_URL above for the `db` and `app`
# services. Not read directly by the Nest app.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=biddaloy

# Application
# NODE_ENV must be one of: development, test, production
NODE_ENV=production
PORT=3000

# CORS: comma-separated allowlist of origins allowed to make credentialed
# cross-origin requests (e.g. https://app.example.com,https://admin.example.com).
# Unset defaults to http://localhost:5173 outside production, and to no
# cross-origin access at all in production — set this once a client SPA is
# deployed to its own domain/CDN instead of being served same-origin.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Production refuses to boot while any value still says change-me/replace-me —
# run `yarn config:check` to see what is left to fix.

# Authentication
# JWT_SECRET must be at least 32 characters — this placeholder is intentionally
# too short so the app refuses to boot until you set a real value.
JWT_SECRET=replace-me
# JWT_SECRET_PREVIOUS=   # verify-only, during a rotation (#2317); never set it to a leaked secret

# docker-compose only (not read by the Nest app).
# APP_DOMAIN: the public hostname nginx answers for.
APP_DOMAIN=localhost
# Image tag to pull from ghcr.io/tareq89/biddaloy-* (a commit SHA). Required.
# No default on purpose. Local builds: APP_VERSION=local with docker-compose.build.yml.
APP_VERSION=
# Host directory holding the Cloudflare Origin CA pair origin.pem + origin.key
# (chmod 600 origin.key). Required, no default. Local builds: ./.certs.
TLS_CERT_DIR=/opt/biddaloy/certs

# Addresses of the CDN/proxy in front of nginx (space or comma separated
# CIDRs). When a request comes from one of these, nginx takes the visitor IP
# from CF-Connecting-IP; any other caller's header is ignored. Leave EMPTY
# unless Cloudflare (or another CDN) is in front: empty = no change at all.
# An invalid entry stops nginx from starting. Get the current list from
# https://www.cloudflare.com/ips-v4/ and https://www.cloudflare.com/ips-v6/
# (see docs/architecture/12-operations.md, "Cloudflare IP ranges changed").
TRUSTED_PROXY_CIDRS=
# TRUSTED_PROXY_CIDRS=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

# Optional: custom app settings
# APP_NAME=SchoolManager
# LOG_LEVEL=debug

# Seed admin password (used by "yarn seed")
# SEED_ADMIN_PASSWORD=change-me-admin-password-123

# TypeORM: set to "true" to auto-sync schema from entities (dev only — never use in prod)
# DB_SYNCHRONIZE=false

# Destructive operations: set to "true" to confirm db:clear / db:reset
# DB_DESTROY_CONFIRM=false

# Communications (SMS/WhatsApp/Email) — see server/src/modules/communications
# Job queue backing the communications module. Prefer 127.0.0.1 over
# "localhost": docker-compose binds redis to the IPv4 loopback, and on a
# dual-stack host "localhost" often resolves to ::1 first, giving ECONNREFUSED.
# REDIS_URL=redis://127.0.0.1:6379

# SMS: which gateway is active — "greenweb" or "mimsms"
# SMS_PROVIDER=greenweb
# GREENWEB_API_KEY=change-me
# MIMSMS_API_KEY=change-me
# MIMSMS_SENDER_ID=change-me

# WhatsApp: Meta Business Cloud API
# WHATSAPP_ACCESS_TOKEN=change-me
# WHATSAPP_PHONE_NUMBER_ID=change-me

# Email: plain SMTP (works with SendGrid's SMTP relay too)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=change-me
# SMTP_PASSWORD=change-me
# SMTP_FROM=no-reply@example.com

# Web push (#552): notify users' browsers without SMS/email. Generate a
# keypair with `node scripts/generate-vapid-keys.mjs`. If any of these
# three is missing, push is disabled (logged once, no crash) — see
# server/src/modules/push/push-config.ts.
# VAPID_PUBLIC_KEY=change-me
# VAPID_PRIVATE_KEY=change-me
# VAPID_SUBJECT=mailto:admin@example.com

# Per-tenant settings encryption (server/src/modules/schools/settings) —
# AES-256-GCM key for schools.settings secrets (WhatsApp/email/SMS
# credentials a school configures for itself). Base64, 32 bytes.
# Required in production; optional in dev/test. Left commented out
# deliberately — even a throwaway value here is real key material a
# secret scanner can't tell apart from a live one, so it's generated
# locally instead of committed. Without it, saving a tenant secret in dev
# throws "Settings encryption is not configured"; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SETTINGS_ENCRYPTION_KEY=change-me
# A key rotation still in its grace window — see EncryptionService's class
# comment for the full procedure. Comma-separated for more than one.
# SETTINGS_ENCRYPTION_KEY_PREVIOUS=

# --- Frontend error tracking / Web Vitals (Sentry, [8.12.7]) ------------
# All optional. Unset is a supported configuration everywhere: no DSN
# means `initSentry` no-ops, no auth token means the build skips the
# source-map upload and produces byte-identical output to before.
# See docs/architecture/07-deployment.md.
#
# Read by the browser at runtime (must be VITE_-prefixed to be inlined):
# VITE_SENTRY_DSN=https://key@o0.ingest.sentry.io/0
# Fraction of transactions (and so Web Vitals samples) sent. Defaults to
# 0.1; a value outside [0, 1] falls back to that default rather than
# being clamped, so a typo cannot mean "send everything".
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
#
# Read by `client-admin/vite.config.ts` at build time only — never
# inlined into the bundle. Set all three to upload source maps and tag
# the release.
# SENTRY_ORG=change-me
# SENTRY_PROJECT=change-me
# SENTRY_AUTH_TOKEN=change-me

# --- Server error tracking (Sentry, [15.1.1]) ---------------------------
# All optional. Unset SENTRY_DSN means initSentry() no-ops — same
# "missing config degrades gracefully" posture as the frontend's
# VITE_SENTRY_DSN above. A DSN that is set but not a valid URL fails boot
# with a clear error rather than silently sending nothing.
# SENTRY_DSN=https://key@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=change-me
# Fraction of transactions sampled. Defaults to 0.1; a value outside
# [0, 1] falls back to that default rather than being clamped.
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Readiness probe (GET /api/health/ready, [15.1.3]) -------------------
# Required to expose the route at all — unset, it's a 404. An uptime
# monitor sends this back as the X-Health-Token header. nginx/ also blocks
# this path from outside the cluster (see nginx/templates/default.conf.template).
# HEALTH_TOKEN=change-me

# --- Object storage (S3-compatible — [15.3.1]) --------------------------
# Any S3-compatible bucket. docker-compose runs a local SeaweedFS for dev
# (see the `seaweedfs` service) — S3_ENDPOINT there is fixed to
# http://seaweedfs:8333 inside the compose network, so it's not listed below.
# All five are required; StorageModule refuses to boot with any of them
# unset, naming the missing variable.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=biddaloy
# Also used as SeaweedFS's S3 admin identity in docker-compose — pick a real
# access key pair for anything beyond local dev.
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
# "true" for SeaweedFS and most self-hosted S3-compatible stores (path-style
# addressing); unset/"false" for AWS S3 itself (virtual-hosted style).
S3_FORCE_PATH_STYLE=true

# --- Backup and disaster recovery ([15.3.2]/[15.3.3]) -------------------
# See docs/architecture/13-backup-restore.md for the full recovery story
# (RPO/RTO, key rotation, the "lost key" failure mode).
#
# age public key backups are encrypted to (age-keygen -o key.txt prints
# both halves; only the public one goes here). Required for the `backup`
# service to run.
# BACKUP_AGE_PUBLIC_KEY=age1...
# Standard 5-field cron (supercronic, TZ=Asia/Dhaka) the `backup` service runs on.
# Unset = hourly (0 * * * *) in R2 mode, once a day (0 2 * * *) in legacy mode.
# BACKUP_SCHEDULE=0 * * * *
# LEGACY mode only (no BACKUP_S3_* below): backups older than this are
# deleted after each successful run. R2 mode uses the *_KEEP counts below.
BACKUP_RETENTION_DAYS=30
# Cloudflare R2 offsite target — set ALL of these or NONE (none = legacy
# S3_* mode: no hourly/daily layout, no files sync). Keys: R2 API token
# scoped to this bucket. The crypt password/salt are NOT recoverable: store
# them outside the host too, or the encrypted files cannot be read back.
# The backup container refuses to start while the R2 secret or a crypt value
# still says change-me or is shorter than 16 characters.
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=change-me
# BACKUP_S3_ACCESS_KEY_ID=change-me
# BACKUP_S3_SECRET_ACCESS_KEY=change-me
# BACKUP_RCLONE_CRYPT_PASSWORD=change-me
# BACKUP_RCLONE_CRYPT_SALT=change-me
# Uptime Kuma push URL, BARE (no query string; backup.sh appends
# ?status=up|down&msg=<step>). The token is in the path — a secret. Unset = no push.
# BACKUP_PUSH_URL=https://status.example.com/api/push/change-me
BACKUP_HOURLY_KEEP=72
BACKUP_DAILY_KEEP=30
BACKUP_TRASH_DAYS=30
# The files sync refuses to sync (touches nothing, Kuma down) if it would delete
# more than this many files in one run. Raise it for one run after a real mass
# delete.
BACKUP_FILES_MAX_DELETE=500
# Wait up to this many seconds for the network before a run (then it tries anyway).
BACKUP_NET_WAIT_SECS=900
# Weekly restore drill (scripts/backup/drill.sh): cron, default Sunday 03:30.
DRILL_SCHEDULE=30 3 * * 0
# Uptime Kuma push URL for the drill, BARE (a separate push monitor from BACKUP_PUSH_URL).
# DRILL_PUSH_URL=https://status.example.com/api/push/change-me
# Host path of the age PRIVATE key, mounted read-only into the backup container
# only (production: written by Ansible from sops). The drill needs R2 mode above.
# BACKUP_AGE_KEY_FILE=/opt/biddaloy/prod/age-key.txt
# Optional: a Sentry cron monitor check-in URL. Unset means no check-in
# (fine for local dev) — production should set this.
# SENTRY_CRON_MONITOR_URL=https://sentry.io/api/0/cron/change-me/change-me/

# Epic 67 (D12): Sentry Cron monitor for the attention engine's FAST sweep (every 5 min). Unset = no check-ins.
# ATTENTION_SENTRY_CRON_URL=https://sentry.io/api/0/cron/change-me/change-me/

# --- Account access (invitations, OTP, recovery — Epic 12.0) -----------
# Base URL of the staff SPA — invitation/reset links target
# `${APP_BASE_URL}/activate?token=...` etc. Defaults to
# http://localhost:5174 outside production; the server refuses to boot
# without it set when NODE_ENV=production.
# APP_BASE_URL=http://localhost:5174
#
# When "true", the invite/resend/forgot-password/otp-request endpoints
# include `debug: { token, otp }` with the real secret in their response —
# for e2e/Playwright specs that need to consume it without scraping the
# delivery provider. The server refuses to boot with this set to "true"
# when NODE_ENV=production.
# ACCOUNT_ACCESS_ECHO_SECRETS=false

# --- Public invoice share links (#666) ----------------------------------
# Base URL of the guardian-facing SPA a share link opens in —
# `POST /invoices/:id/share` returns `${PUBLIC_APP_URL}/i/<token>`.
# Defaults to http://localhost:5174 outside production (there is no
# separate client-student app in this repo yet; this points at the same
# origin as APP_BASE_URL until one exists). Required in production the
# same way APP_BASE_URL is.
# PUBLIC_APP_URL=http://localhost:5174

# --- Onboarding and trials (Epic 13.0, [13.1.2]) ------------------------
# All optional. Unset means the default shown, applied where each value
# is read.
# Length of a new school's free trial, in days. Default 30.
# TRIAL_DAYS=30
# Seats (active students) a school gets during its trial. Default 10.
# TRIAL_SEAT_LIMIT=10
# Comma-separated phone prefixes a sign-up OTP SMS may be sent to.
# Default +880 (Bangladesh only).
# OTP_SMS_ALLOWED_PREFIXES=+880
# Cloudflare Turnstile secret for the public sign-up form.
# TURNSTILE_SECRET_KEY=change-me
# Its public site key, inlined into the client bundle at build time.
# `docker compose up --build` passes it as a build arg; a plain
# `docker build` needs `--build-arg VITE_TURNSTILE_SITE_KEY=...`.
# Set both or neither: a secret with no site key rejects every sign-up.
# VITE_TURNSTILE_SITE_KEY=change-me
# "Sign in with Google" / "Sign in with Facebook" app credentials.
# GOOGLE_OAUTH_CLIENT_ID=change-me
# GOOGLE_OAUTH_CLIENT_SECRET=change-me
# FACEBOOK_OAUTH_CLIENT_ID=change-me
# FACEBOOK_OAUTH_CLIENT_SECRET=change-me
# Meta also needs the data-deletion callback URL set in the app dashboard:
#   <APP_BASE_URL>/api/v1/auth/social/facebook/data-deletion
# Link shown to users who need help (e.g. a trial has ended). https: or
# mailto: only. The trial-ended screen cannot ask the server for it (every
# request 403s by then), so the client bundle carries it too: Compose
# passes this value as the `VITE_SUPPORT_URL` build arg; a plain
# `docker build` or `yarn dev` needs VITE_SUPPORT_URL set to the same value.
# SUPPORT_CONTACT_URL=https://example.com/support
# VITE_SUPPORT_URL=https://example.com/support
