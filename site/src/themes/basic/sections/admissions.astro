---
import { t } from '../../../i18n/t';
import { field } from '../../../lib/pick';
import type { SectionProps } from '../../../lib/types';

const { data, lang, feed } = Astro.props as SectionProps;
const title = field(data.title, lang);
const body = field(data.body, lang);
const s = (v: unknown) => (typeof v === 'string' ? v : undefined);
const loc = lang === 'en' ? 'en-GB' : 'bn-BD';
// Open intakes (never marked empty by the server: the text above still shows without them).
const intakes = feed.filter((i) => s(i.link)?.startsWith('/'));
---
<section class="sec" id="admissions"><div class="wrap">
  {title && <div class="sec-head"><h2>{title}</h2></div>}
  {body && <p class="muted" style="white-space:pre-line">{body}</p>}
  {intakes.length > 0 && (
    <ul class="intakes">
      {intakes.map((i) => (
        <li class="card">
          <b>{s(i.title)}</b>
          {s(i.deadline) && <span class="small">{t(lang, 'admissions.deadline')}: {new Date(`${s(i.deadline)}T00:00:00+06:00`).toLocaleDateString(loc, { dateStyle: 'long', timeZone: 'Asia/Dhaka' })}</span>}
          <a class="btn btn-sm" href={s(i.link)}>{t(lang, 'admissions.apply')}</a>
        </li>
      ))}
    </ul>
  )}
</div></section>
