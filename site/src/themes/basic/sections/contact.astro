---
import { t } from '../../../i18n/t';
import { field, pick } from '../../../lib/pick';
import type { SectionProps } from '../../../lib/types';

const { data, lang, manifest } = Astro.props as SectionProps;
const title = field(data.title, lang) ?? t(lang, 'section.contact');
const c = manifest.contact;
const rows = [
  ['contact.address', field(data.address, lang) ?? pick(c?.address, lang)],
  ['contact.phone', c?.phone],
  ['contact.email', c?.email],
  ['contact.hours', pick(c?.hours, lang)],
].filter((r): r is [string, string] => !!r[1]);
---
<section class="sec" id="contact"><div class="wrap contact">
  <div>
    <h2>{title}</h2>
    <dl class="kv" style="margin:16px 0 20px">
      {rows.map(([k, v]) => <><dt>{t(lang, k)}</dt><dd>{v}</dd></>)}
    </dl>
  </div>
</div></section>
