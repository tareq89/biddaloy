---
import { t } from '../i18n/t';
import { themeCss, toStyle } from '../lib/css-vars';
import { pick } from '../lib/pick';
import type { Lang, SiteManifest } from '../lib/types';

interface Props {
  manifest: SiteManifest;
  lang: Lang;
  /** Path after the language prefix (`` for home), used for hreflang and canonical. */
  rest?: string;
  title?: string;
  /** Short plain-text summary (blog excerpt); falls back to the school's address line. */
  description?: string;
  /** Site path of a picture (`/media/<id>`, default the logo); made absolute from the request origin. */
  image?: string;
}
const { manifest, lang, rest = '', title, description, image } = Astro.props;
const host = Astro.locals.host;
const alt = (l: Lang) => `https://${host}/${l}/${rest}`;
const { vars, fontFaces } = themeCss(manifest);
const noindex = manifest.noindex || !!Astro.locals.preview;
const name = pick(manifest.schoolName, lang) ?? '';
const fullTitle = title ? `${title} · ${name}` : name;
// Values reach the page only through Astro's escaping of attribute expressions.
const desc = (description ?? pick(manifest.contact?.address, lang) ?? fullTitle).slice(0, 200);
const pic = image ?? manifest.logo;
const ogImage = pic?.startsWith('/') ? new URL(pic, `https://${host}`).href : undefined;
---
<!doctype html>
<html lang={lang} style={toStyle(vars)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'bn_BD'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <>
      <link rel="alternate" hreflang="bn" href={alt('bn')} />
      <link rel="alternate" hreflang="en" href={alt('en')} />
      <link rel="alternate" hreflang="x-default" href={alt('bn')} />
      <link rel="canonical" href={alt(lang)} />
    </>}
    <style set:html={fontFaces}></style>
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'skip')}</a>
    <slot />
  </body>
</html>
