# cloudflared config, rendered by tasks/write-env.yml into /opt/biddaloy/edge/cloudflared/config.yml.
# The one cloudflared template (D17). One thing to know: staging and the ops
# hosts sit behind different Cloudflare Access apps (D14), so each group gets its own audience
# tag (CF_ACCESS_AUD_STAGING, CF_ACCESS_AUD_OPS). The credentials file sits beside this one.
tunnel: {{ tunnel_id }}
credentials-file: /etc/cloudflared/credentials.json

ingress:
  # Kuma push monitors reach Kuma without Access (D14); Kuma checks the push token itself.
  - hostname: {{ secret_env.edge.KUMA_DOMAIN }}
    path: ^/api/push/
    service: http://nginx:80
{# www.<landing> too: nginx/templates/landing.conf.template redirects it to the apex. #}
{% for host in [secret_env.edge.APP_DOMAIN, secret_env.edge.LANDING_DOMAIN, 'www.' ~ secret_env.edge.LANDING_DOMAIN, secret_env.edge.DEMO_DOMAIN, secret_env.edge.INBOX_DEMO_DOMAIN] %}
  - hostname: {{ host }}
    service: http://nginx:80
{% endfor %}
{% for group in [[[secret_env.edge.STAGING_DOMAIN, secret_env.edge.INBOX_STAGING_DOMAIN], aud_staging], [[secret_env.edge.KUMA_DOMAIN, secret_env.edge.BESZEL_DOMAIN, secret_env.edge.LOGS_DOMAIN], aud_ops]] %}
{% for host in group[0] %}
  - hostname: {{ host }}
    service: http://nginx:80
    originRequest:
      access:
        required: true
        teamName: "{{ cf_access_team }}"
        audTag: ["{{ group[1] }}"]
{% endfor %}
{% endfor %}
{# No '*.<root>' rule here, on purpose (Epic 40, runbook part 17a). cloudflared matches hostnames
   case-sensitively, so 'STAGING.<root>' would miss the staging rule above, fall into a wildcard
   and skip the Access check. (A trailing-dot name matches no hostname rule and falls to the last one.) Production school sites are the catch-all below (only '*-staging.<root>' has its own rule), to a SEPARATE nginx
   listener that holds no fixed host (#3620 / #3655, runbook part 17d). #}
  {# Staging school sites (#3715): Access in the VM too, like staging.<root>. Fixed staging hosts
     (inbox-staging.<root>) are matched by the rules above first. A case or trailing-dot spelling
     misses this glob (cloudflared is case-sensitive); nginx :8081 answers 444 to those
     (site.conf.template). #}
  - hostname: "*-staging.{{ secret_env.edge.ROOT_DOMAIN }}"
    service: http://nginx:8081
    originRequest:
      access:
        required: true
        teamName: "{{ cf_access_team }}"
        audTag: ["{{ aud_staging }}"]
  # Last rule (required, matches any name no rule above matched, in any letter case):
  # the SEPARATE site listener, :8081, which serves <school>.ROOT_DOMAIN and a school's own custom
  # domain (Host = www.school.edu.bd, via sites.<root>), and answers 444 to fixed hosts and anything
  # else under ROOT_DOMAIN (nginx/templates/site.conf.template, #3620 / #3655). No sites.<root> rule
  # is needed: the custom host arrives under its own name.
  - service: http://nginx:8081
