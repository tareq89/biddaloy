# Same keys as prod.example.env, plus the Demo section at the end. Values empty on purpose.
# Real values: `sops infra/secrets/demo.enc.env` (see README.md).

# --- Core ---
APP_VERSION=
APP_DOMAIN=
APP_BASE_URL=
# Comma-separated allowed browser origins.
CORS_ORIGINS=
# Cloudflare IP ranges nginx trusts for CF-Connecting-IP (12-operations.md 3.5).
TRUSTED_PROXY_CIDRS=
PUBLIC_APP_URL=
# Host directory holding the Cloudflare Origin CA pair nginx serves: /opt/biddaloy/certs.
TLS_CERT_DIR=
# Postgres superuser password (rotation: ALTER ROLE, then redeploy).
POSTGRES_USER=
POSTGRES_DB=
# must contain "demo"
S3_BUCKET=
POSTGRES_PASSWORD=
# Signs sessions. Rotation signs everyone out unless JWT_SECRET_PREVIOUS is set.
JWT_SECRET=
JWT_SECRET_PREVIOUS=
# Encrypts per-school settings at rest.
SETTINGS_ENCRYPTION_KEY=
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
# Must be true in production or the app refuses to boot (server/src/db-ssl.ts).
DB_SSL=
# Sent as the x-health-token header to /api/health/ready.
HEALTH_TOKEN=
# SeaweedFS identity used by the app.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Backups ---
# Encrypts every dump. Not a secret.
BACKUP_AGE_PUBLIC_KEY=
# Host directory of the matching private key (key.txt inside), read only by the
# weekly restore drill (D18): /opt/biddaloy/demo/drill (provision.yml creates it).
BACKUP_AGE_KEY_DIR=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RCLONE_CRYPT_PASSWORD=
BACKUP_RCLONE_CRYPT_SALT=
# Uptime-monitor push URLs; they embed a token.
BACKUP_PUSH_URL=
DRILL_PUSH_URL=

# --- Providers ---
TURNSTILE_SECRET_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
# Sentry cron monitor check-in URL; it embeds a token.
SENTRY_CRON_MONITOR_URL=

# Platform alert SMS (12-operations.md 3.6).
PLATFORM_SMS_PROVIDER=
PLATFORM_SMS_API_KEY=
PLATFORM_SMS_SENDER_ID=
PLATFORM_SMS_API_URL=
# Fallback alert numbers, comma-separated, used when no platform SUPER_ADMIN has a verified phone.
PLATFORM_ALERT_PHONES=

# --- Demo ---
# Shared login of the demo school; the demo reset job re-applies it.
DEMO_PASSWORD=
# One of these two is required (docker-compose.demo.yml): a command that drives
# the post-reset sweep, or true to skip the sweep.
DEMO_SWEEP_CMD=
DEMO_SKIP_SWEEP=
# Sentry crons check-in URL for the demo reset job; it embeds a token.
SENTRY_CRONS_URL=
# Uptime Kuma push URL of the demo-reset-nightly monitor; it embeds a token.
DEMO_RESET_PUSH_URL=
