# Keys of infra/secrets/demo.enc.env, read by deploy/stack.yml (ENV_NAME=demo). Values empty on
# purpose, except the few non-secret defaults scripts/check-tracked-files.mjs lists.
# Real values: `sops infra/secrets/demo.enc.env` (see README.md). Never put a value here.
# The demo holds only invented data, rebuilt every night by the demo-reset job.

# --- Stack ---
ENV_NAME=demo
DEMO_MODE=true
# The sink profile is the mailpit test inbox, a long-running service (config:check requires
# it here). Never add demo-jobs: `docker compose run demo-reset ...` turns it on by itself, and set
# here it would make `up -d` start the one-off runner (config:check refuses it).
COMPOSE_PROFILES=sink
# Image tag (git sha) to run; the deploy sets it.
APP_VERSION=
# Memory limits (D23). Empty = the default in deploy/stack.yml.
APP_MEM=768m
PG_MEM=1g
REDIS_MEM=128m
S3_MEM=256m
APP_CPUS=
PG_CPUS=
REDIS_CPUS=
S3_CPUS=

# --- URLs ---
# Public https origin of the demo. Example shape: https://demo.school.example
APP_BASE_URL=
PUBLIC_APP_URL=
CORS_ORIGINS=
SUPPORT_CONTACT_URL=

# --- Database and files (the demo's own, never prod's) ---
POSTGRES_USER=
# Must be biddaloy_demo (config:check --env demo).
POSTGRES_DB=
POSTGRES_PASSWORD=
# Must be biddaloy-demo (config:check --env demo), never the prod bucket.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DB_SSL_REJECT_UNAUTHORIZED=

# --- App secrets ---
JWT_SECRET=
JWT_SECRET_PREVIOUS=
SETTINGS_ENCRYPTION_KEY=
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
HEALTH_TOKEN=
# Shared login of the demo school; the demo reset re-applies it.
DEMO_PASSWORD=

# --- Demo reset (scripts/demo/reset.sh) ---
# Kuma push URL of the nightly rebuild monitor; it embeds a token.
DEMO_RESET_PUSH_URL=
# Sentry crons check-in URL for the rebuild; it embeds a token.
SENTRY_CRONS_URL=
# One of these two is required: a command that drives the post-reset sweep, or true to skip it.
DEMO_SWEEP_CMD=
DEMO_SKIP_SWEEP=
# Left empty: the defaults in deploy/stack.yml.
DEMO_SWEEP_URL=
DEMO_SWEEP_TIMEOUT=
DEMO_SCALE=
DEMO_YEARS=
DEMO_RESET_MEM=
DEMO_RESET_CPUS=

# --- Providers ---
# Test inbox (Mailpit): required on this stack, never on prod.
MESSAGE_SINK=mailpit
MESSAGE_SINK_PUBLIC_URL=https://inbox-demo.school.example
# Cloudflare's always-pass TEST pair: public forms work on the demo, no real captcha.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
SENTRY_DSN=
SENTRY_DSN_WEB=
# 0 to 1, example 0.1. Fill it: an empty value fails boot.
SENTRY_TRACES_SAMPLE_RATE=
# Left empty on purpose (config:check refuses a value).
SMS_PROVIDER=
GREENWEB_API_KEY=
MIMSMS_API_KEY=
MIMSMS_SENDER_ID=
ONECODESOFT_API_KEY=
ONECODESOFT_SENDER_ID=
ONECODESOFT_API_URL=
