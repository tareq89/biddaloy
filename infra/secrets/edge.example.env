# Keys of infra/secrets/edge.enc.env, read by deploy/edge.yml, deploy/edge.direct.yml, the
# deploy playbooks and the Telegram messages. Values empty on purpose, except the
# few non-secret defaults scripts/check-tracked-files.mjs lists.
# Real values: `sops infra/secrets/edge.enc.env` (see README.md). Never put a value here.

# --- Mode ---
# tunnel is Cloudflare Tunnel, no public web ports (now). direct = ports 80 and 443 with
# Let's Encrypt, for a host without Cloudflare (BDIX, later).
EDGE_MODE=tunnel
# Memory and CPU limits of nginx. Empty = the defaults in deploy/edge.yml.
NGINX_MEM=
NGINX_CPUS=

# --- Hostnames (no scheme). Example shape: app.school.example ---
APP_DOMAIN=
STAGING_DOMAIN=
DEMO_DOMAIN=
LANDING_DOMAIN=
KUMA_DOMAIN=
BESZEL_DOMAIN=
LOGS_DOMAIN=
# Container name nginx reaches the ops stack on. Empty on a host without the ops stack.
OPS_UPSTREAM_HOST=
# Image tag of the landing site.
LANDING_VERSION=

# --- Cloudflare Tunnel (tunnel mode, D17) ---
CLOUDFLARE_TUNNEL_ID=
# The whole credentials JSON on ONE line.
CLOUDFLARE_TUNNEL_CREDENTIALS_JSON=
# Zero Trust team name. Example shape: myteam (from myteam.cloudflareaccess.com)
CF_ACCESS_TEAM=
# Application audience tags of the Access apps that protect staging and ops (D14).
CF_ACCESS_AUD_STAGING=
CF_ACCESS_AUD_OPS=

# --- Direct mode ---
# Outer login for staging and ops hosts: one htpasswd line per user, bcrypt (`htpasswd -nB user`).
BASIC_AUTH_HTPASSWD=
# Contact address Let's Encrypt writes to. Example shape: ops@school.example
LETSENCRYPT_EMAIL=

# --- Image pulls (the repo is private, P16) ---
GHCR_PULL_USER=
# Personal access token with only read:packages.
GHCR_PULL_TOKEN=

# --- Alerts ---
# Deploy messages. Example shape: 123456:ABC... and -1001234567890
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ops agent ---
# Public key from the Beszel hub ("Add system"); the same value as ops.example.env.
BESZEL_KEY=
