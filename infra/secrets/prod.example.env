# Keys of infra/secrets/prod.enc.env, read by deploy/stack.yml (ENV_NAME=prod). Values empty on
# purpose, except the few non-secret defaults scripts/check-tracked-files.mjs lists.
# Real values: `sops infra/secrets/prod.enc.env` (see README.md). Never put a value here.
# Make each random secret with `openssl rand -hex 32` (hex only: compose expands `$`).

# --- Stack ---
ENV_NAME=prod
# replica is the second app container (D25); backup is hourly encrypted dump to R2.
COMPOSE_PROFILES=replica,backup
# Image tag (git sha) to run; the deploy sets it. Example shape: 3f9c2ab...
APP_VERSION=
# Memory limits (D23). Empty = the default in deploy/stack.yml. Tune from Beszel.
APP_MEM=1200m
PG_MEM=2g
REDIS_MEM=256m
S3_MEM=512m
APP_CPUS=
PG_CPUS=
REDIS_CPUS=
S3_CPUS=

# --- URLs ---
# Public https origin, no trailing slash. Example shape: https://app.school.example
APP_BASE_URL=
# Public https origin of invoice share links. Usually the same as APP_BASE_URL.
PUBLIC_APP_URL=
# Comma-separated allowed browser origins.
CORS_ORIGINS=
# Contact link shown in the SPA. Example shape: https://wa.me/8801XXXXXXXXX
SUPPORT_CONTACT_URL=
# Id of the platform school: its SUPER_ADMINs get platform rights. Empty = nobody does.
PLATFORM_TENANT_ID=

# --- Database and files (the stack's own Postgres and SeaweedFS) ---
POSTGRES_USER=
# Must not be the same as staging or demo. Example shape: biddaloy
POSTGRES_DB=
# Hex only. Rotation: ALTER ROLE, then redeploy.
POSTGRES_PASSWORD=
# Bucket created by SeaweedFS on boot. Example shape: biddaloy
S3_BUCKET=
S3_REGION=
# SeaweedFS identity used by the app. Make with `openssl rand -hex 16`.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Left empty: verify the database certificate (keep it so).
DB_SSL_REJECT_UNAUTHORIZED=

# --- App secrets ---
# Signs sessions. Rotation signs everyone out unless JWT_SECRET_PREVIOUS is set.
JWT_SECRET=
JWT_SECRET_PREVIOUS=
# Encrypts per-school settings at rest. Base64 of 32 bytes: `openssl rand -base64 32`.
SETTINGS_ENCRYPTION_KEY=
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
# Sent as the x-health-token header to /api/health/ready.
HEALTH_TOKEN=

# --- Backups (Cloudflare R2, write token) ---
# Encrypts every dump. A public key, example shape: age1...
BACKUP_AGE_PUBLIC_KEY=
# Cloudflare R2 S3 endpoint. Example shape: https://<account>.r2.cloudflarestorage.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
# R2 token with write access to the backup bucket.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# rclone crypt passphrase and salt: file names and contents are encrypted before upload.
BACKUP_RCLONE_CRYPT_PASSWORD=
BACKUP_RCLONE_CRYPT_SALT=
# Kuma push URL of the backup monitor; it embeds a token.
BACKUP_PUSH_URL=
# Kuma push URL of the nightly log-archive monitor (read by the host script biddaloy-nightly); it embeds a token.
LOG_ARCHIVE_PUSH_URL=
# Sentry cron monitor check-in URL; it embeds a token.
SENTRY_CRON_MONITOR_URL=
# Left empty: the defaults in deploy/stack.yml.
BACKUP_SCHEDULE=
BACKUP_RETENTION_DAYS=
BACKUP_HOURLY_KEEP=
BACKUP_DAILY_KEEP=
BACKUP_TRASH_DAYS=
BACKUP_FILES_MAX_DELETE=
BACKUP_NET_WAIT_SECS=
BACKUP_MEM=
BACKUP_CPUS=
JOBS_MEM=
JOBS_CPUS=

# --- Providers ---
# Test inbox: leave unset on prod (config:check refuses MESSAGE_SINK=mailpit).
# MESSAGE_SINK=
# MESSAGE_SINK_PUBLIC_URL=
# Cloudflare Turnstile pair (both or neither).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Error reporting. Example shape: https://<key>@o0.ingest.sentry.io/0
SENTRY_DSN=
SENTRY_DSN_WEB=
# 0 to 1, example 0.1. Fill it: deploy/stack.yml passes an unset value as empty, which fails boot.
SENTRY_TRACES_SAMPLE_RATE=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
# Platform alert SMS (12-operations.md 3.6): name one provider and fill its keys.
SMS_PROVIDER=
GREENWEB_API_KEY=
GREENWEB_API_URL=
MIMSMS_API_KEY=
MIMSMS_SENDER_ID=
MIMSMS_API_URL=
ONECODESOFT_API_KEY=
ONECODESOFT_SENDER_ID=
ONECODESOFT_API_URL=
# Deprecated, read until the next release when SMS_PROVIDER is unset; use the keys above.
PLATFORM_SMS_PROVIDER=
PLATFORM_SMS_API_KEY=
PLATFORM_SMS_SENDER_ID=
PLATFORM_SMS_API_URL=
# Fallback alert numbers, comma-separated, used when no platform SUPER_ADMIN has a verified phone.
PLATFORM_ALERT_PHONES=
# Left empty, the default is +880.
OTP_SMS_ALLOWED_PREFIXES=

# --- Post-deploy smoke (scripts/smoke-post-deploy.mjs, D20) ---
# Logins of the "Smoke Test School" in prod.
SMOKE_SCHOOL_SLUG=
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_TEACHER_EMAIL=
SMOKE_TEACHER_PASSWORD=
SMOKE_SUPER_ADMIN_EMAIL=
SMOKE_SUPER_ADMIN_PASSWORD=
