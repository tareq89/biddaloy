# Keys of infra/secrets/ops.enc.env. Values empty on purpose.
# Real values: `sops infra/secrets/ops.enc.env` (see README.md).
# The Kuma and Beszel admin accounts are made in their UIs, not here.

# The ops hostname nginx and Cloudflare Access answer for, e.g. ops.example.com.
OPS_DOMAIN=
# Public key from the Beszel hub ("Add system"). Not secret, but the agent will not start without it.
BESZEL_KEY=
