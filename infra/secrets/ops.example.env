# Keys of infra/secrets/ops.enc.env, read by deploy/ops.yml. Values empty on purpose.
# Real values: `sops infra/secrets/ops.enc.env` (see README.md). Never put a value here.
# The Kuma and Beszel admin accounts are made in their UIs, not here.

# Public key from the Beszel hub ("Add system"). Not secret. Empty on the first run: only the
# agent restarts until it is set (12-operations.md section 1, step 3).
BESZEL_KEY=
# The whole Dozzle users.yml (bcrypt hashes), one line with \n for newlines; the deploy renders
# it to /opt/biddaloy/ops/dozzle/users.yml (D14).
DOZZLE_USERS_YML=
# Memory limits. Empty = the defaults in deploy/ops.yml.
BESZEL_MEM=
KUMA_MEM=
DOZZLE_MEM=
