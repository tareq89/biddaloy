# Keys of infra/secrets/staging.enc.env, read by deploy/stack.yml (ENV_NAME=staging). Values empty
# on purpose, except the few non-secret defaults scripts/check-tracked-files.mjs lists.
# Real values: `sops infra/secrets/staging.enc.env` (see README.md). Never put a value here.
# Staging is a scrubbed copy of prod data (D6): no OAuth, SMS or real Turnstile secret, ever.
# `yarn config:check --env staging` fails if any SMS / WhatsApp / email / push key is set.

# --- Stack ---
ENV_NAME=staging
# Prod data is refused under demo mode, so staging runs with it off.
DEMO_MODE=false
# The sink profile is the mailpit test inbox, a long-running service (config:check requires
# it here). Never add jobs: `docker compose run jobs ...` turns it on by itself, and set
# here it would make `up -d` start the one-off runner (config:check refuses it).
COMPOSE_PROFILES=sink
# Image tag (git sha) to run; the deploy sets it.
APP_VERSION=
# Memory limits (D23). Empty = the default in deploy/stack.yml.
APP_MEM=768m
PG_MEM=1g
REDIS_MEM=128m
S3_MEM=256m
APP_CPUS=
PG_CPUS=
REDIS_CPUS=
S3_CPUS=

# --- URLs ---
# Public https origin of staging. Example shape: https://staging.school.example
APP_BASE_URL=
PUBLIC_APP_URL=
CORS_ORIGINS=
SUPPORT_CONTACT_URL=
# The same school id as prod (the copy keeps it). Required: the nightly refresh keeps its super
# admins' emails, and config:check --env staging refuses an empty or non-uuid value.
PLATFORM_TENANT_ID=

# --- Database and files (staging's own, never prod's) ---
POSTGRES_USER=
# Must be biddaloy_staging (config:check --env staging).
POSTGRES_DB=
POSTGRES_PASSWORD=
# Must be biddaloy-staging (config:check --env staging), never the prod bucket.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DB_SSL_REJECT_UNAUTHORIZED=

# --- App secrets (new values, not prod's) ---
JWT_SECRET=
JWT_SECRET_PREVIOUS=
SETTINGS_ENCRYPTION_KEY=
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
HEALTH_TOKEN=
# One login for the scrubbed copy: every user gets this password (at least 12 characters).
STAGING_PASSWORD=

# --- Refresh from the prod backup (D19) ---
# Public key of prod's backup (same as prod's BACKUP_AGE_PUBLIC_KEY).
BACKUP_AGE_PUBLIC_KEY=
# The private half. W3.01 writes it to /opt/biddaloy/staging/restore/key.txt. Example shape: AGE-SECRET-KEY-1...
BACKUP_AGE_PRIVATE_KEY=
# Required (config:check --env staging). Only db/ dumps are read: the rclone crypt password of
# prod's file backup is never given to staging (config:check refuses BACKUP_RCLONE_CRYPT_*).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
# R2 token with READ-ONLY access: staging can never overwrite a prod backup.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Kuma push URLs; they embed a token.
BACKUP_PUSH_URL=
STAGING_REFRESH_PUSH_URL=
SENTRY_CRON_MONITOR_URL=
BACKUP_SCHEDULE=
BACKUP_RETENTION_DAYS=
BACKUP_HOURLY_KEEP=
BACKUP_DAILY_KEEP=
BACKUP_TRASH_DAYS=
BACKUP_FILES_MAX_DELETE=
BACKUP_NET_WAIT_SECS=
BACKUP_MEM=
BACKUP_CPUS=
JOBS_MEM=
JOBS_CPUS=

# --- Providers ---
# Test inbox (Mailpit): required on this stack, never on prod.
MESSAGE_SINK=mailpit
MESSAGE_SINK_PUBLIC_URL=https://inbox-staging.school.example
# Off by default (left empty). Only staging accepts it; demo and prod ignore it.
# To send REAL email/SMS/WhatsApp from staging instead: set this to true, MESSAGE_SINK=real,
# fill the provider keys, and drop COMPOSE_PROFILES=sink. Real contacts get real messages.
ALLOW_REAL_PROVIDERS_ON_STAGING=
# Cloudflare's always-pass TEST pair: public forms work on staging, no real captcha.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
SENTRY_DSN=
SENTRY_DSN_WEB=
# 0 to 1, example 0.1. Fill it: an empty value fails boot.
SENTRY_TRACES_SAMPLE_RATE=
# Left empty on purpose (config:check refuses a value). Listed so the compose file has them all.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
PLATFORM_SMS_PROVIDER=
PLATFORM_SMS_API_KEY=
PLATFORM_SMS_SENDER_ID=
PLATFORM_SMS_API_URL=
PLATFORM_ALERT_PHONES=
OTP_SMS_ALLOWED_PREFIXES=

# --- Post-deploy smoke (same emails as prod; password = STAGING_PASSWORD) ---
# Required: the refresh keeps this school's emails (lowercase letters, digits, dashes).
SMOKE_SCHOOL_SLUG=
SMOKE_ADMIN_EMAIL=
SMOKE_ADMIN_PASSWORD=
SMOKE_TEACHER_EMAIL=
SMOKE_TEACHER_PASSWORD=
SMOKE_SUPER_ADMIN_EMAIL=
SMOKE_SUPER_ADMIN_PASSWORD=
# Test inbox check (Epic 87): Mailpit API on the stack network. Leave unset on prod (check skipped).
SMOKE_INBOX_API_URL=http://staging-mailpit:8025

# base64 of the bcrypt cost-12 hash of STAGING_PASSWORD (staging-refresh.sh sets it on every user).
# base64 because compose expands every `$` in a .env value and a bcrypt hash is full of them.
# Make it with the app's hashPassword (see README.md). config:check checks it matches STAGING_PASSWORD.
STAGING_PASSWORD_HASH_B64=
# HH:MM Dhaka time to stop waiting for last night's backup. Empty = 02:50.
STAGING_REFRESH_DEADLINE=
