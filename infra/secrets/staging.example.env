# Staging: no provider keys (Turnstile, OAuth, SMS) on purpose (D25).
# Real values: `sops infra/secrets/staging.enc.env` (see README.md).

# --- Core ---
APP_VERSION=
APP_DOMAIN=
APP_BASE_URL=
# Comma-separated allowed browser origins.
CORS_ORIGINS=
# Cloudflare IP ranges nginx trusts for CF-Connecting-IP (12-operations.md 3.5).
TRUSTED_PROXY_CIDRS=
PUBLIC_APP_URL=
# Postgres superuser password (rotation: ALTER ROLE, then redeploy).
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
# Signs sessions. Rotation signs everyone out unless JWT_SECRET_PREVIOUS is set.
JWT_SECRET=
JWT_SECRET_PREVIOUS=
# Encrypts per-school settings at rest.
SETTINGS_ENCRYPTION_KEY=
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
# Sent as the x-health-token header to /api/health/ready.
HEALTH_TOKEN=
# SeaweedFS identity used by the app.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Backups ---
# Public half only. The private key never lives on the server.
BACKUP_AGE_PUBLIC_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RCLONE_CRYPT_PASSWORD=
BACKUP_RCLONE_CRYPT_SALT=
# Uptime-monitor push URL; it embeds a token.
BACKUP_PUSH_URL=
SENTRY_CRON_MONITOR_URL=

# Cloudflare's always-pass TEST secret: public forms work on staging, no real captcha.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
