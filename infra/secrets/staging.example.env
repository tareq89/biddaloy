# Staging: no OAuth or SMS keys on purpose; D25 makes `yarn config:check --env staging`
# fail if any SMS, WhatsApp or platform-SMS key is set. Turnstile uses the public test key below.
# No backup keys: staging takes no backups (its data is a re-seedable demo school).
# Real values: `sops infra/secrets/staging.enc.env` (see README.md).

# --- Core ---
APP_VERSION=
APP_DOMAIN=
APP_BASE_URL=
# Comma-separated allowed browser origins.
CORS_ORIGINS=
# Cloudflare IP ranges nginx trusts for CF-Connecting-IP (12-operations.md 3.5).
TRUSTED_PROXY_CIDRS=
PUBLIC_APP_URL=
# Postgres superuser password (rotation: ALTER ROLE, then redeploy).
POSTGRES_USER=
# Must be biddaloy_staging (config:check --env staging).
POSTGRES_DB=
POSTGRES_PASSWORD=
# Signs sessions. Rotation signs everyone out unless JWT_SECRET_PREVIOUS is set.
JWT_SECRET=
JWT_SECRET_PREVIOUS=
# Encrypts per-school settings at rest.
SETTINGS_ENCRYPTION_KEY=
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
# Must be true in production or the app refuses to boot (server/src/db-ssl.ts).
DB_SSL=
# Sent as the x-health-token header to /api/health/ready.
HEALTH_TOKEN=
# SeaweedFS identity used by the app.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Backups ---
# Encrypts every dump. Not a secret.
BACKUP_AGE_PUBLIC_KEY=
# Host directory of the matching private key (key.txt inside), read only by the
# weekly restore drill (D18): /opt/biddaloy/staging/drill (provision.yml creates it).
BACKUP_AGE_KEY_DIR=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RCLONE_CRYPT_PASSWORD=
BACKUP_RCLONE_CRYPT_SALT=
# Uptime-monitor push URLs; they embed a token.
BACKUP_PUSH_URL=
DRILL_PUSH_URL=
SENTRY_CRON_MONITOR_URL=
# --- Staging ---
# Staging runs the seeded demo school on its own bucket (config:check --env staging).
DEMO_MODE=true
S3_BUCKET=biddaloy-staging
# Shared login of the seeded demo school (07-deployment.md "Seed it").
DEMO_PASSWORD=
# The seeded default-school id, set after the first seed. Empty = no platform authority.
PLATFORM_TENANT_ID=
# Compose needs it to parse docker-compose.yml, although staging runs no nginx:
# /opt/biddaloy/certs.
TLS_CERT_DIR=

# Cloudflare's always-pass TEST keys: public forms work on staging, no real captcha.
# Both or neither (env.validation.ts).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
