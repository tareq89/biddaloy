{
  "name": "schoolmanager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "shared",
    "ui",
    "client-*"
  ],
  "scripts": {
    "build:all": "bash scripts/build-all.sh",
    "build:shared": "yarn workspace @biddaloy/shared build",
    "build:ui": "yarn workspace @biddaloy/ui lint",
    "build:server": "yarn workspace @biddaloy/server build",
    "build:client-admin": "yarn workspace @biddaloy/client-admin build",
    "dev:server": "yarn workspace @biddaloy/server start:dev",
    "dev:client-admin": "yarn workspace @biddaloy/client-admin dev",
    "e2e:serve:server": "yarn workspace @biddaloy/server build && node server/dist/main.js",
    "e2e:serve:client": "yarn build:client-admin && yarn workspace @biddaloy/client-admin preview --port 5174 --strictPort",
    "api:types": "yarn workspace @biddaloy/server docs:generate && yarn workspace @biddaloy/ui api:types",
    "lint": "yarn workspace @biddaloy/server lint",
    "typecheck": "tsc -b",
    "typecheck:clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "test": "yarn workspace @biddaloy/server test",
    "test:frontend": "vitest",
    "test:frontend:coverage": "vitest run --coverage",
    "test:frontend:changed": "vitest run --changed origin/main",
    "test:timings": "rm -rf ci-timings && (CI_TIMINGS_OUT=ci-timings/raw-local.json vitest run; ec=$?; node scripts/ci-timings.mjs collect --runner vitest --suite local --job local --in ci-timings/raw-local.json --out ci-timings/local.json && node scripts/ci-timings.mjs report ci-timings/local.json; exit $ec)",
    "coverage": "yarn test:frontend:coverage && node scripts/open-coverage-report.mjs",
    "test:cov": "yarn workspace @biddaloy/server test:cov",
    "test:affected": "node scripts/test-affected.mjs",
    "test:unit:watch": "yarn workspace @biddaloy/server test:unit:watch",
    "check:node": "node scripts/check-node-version.mjs",
    "check:public-branding": "node scripts/check-public-branding.mjs",
    "test:unit": "yarn workspace @biddaloy/server test:unit",
    "test:unit:changed": "yarn workspace @biddaloy/server test:unit:changed",
    "test:integration": "yarn workspace @biddaloy/server test:integration",
    "test:e2e": "yarn workspace @biddaloy/server test:e2e",
    "test:file": "yarn workspace @biddaloy/server test:file",
    "e2e": "playwright test",
    "e2e:pwa": "playwright test -c playwright.pwa.config.ts",
    "ci:local": "bash scripts/ci-local.sh",
    "prepare": "husky",
    "check": "node scripts/check.mjs",
    "test:server": "yarn db:test:up && yarn test:unit && yarn test:integration && yarn test:e2e",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait postgres redis minio && docker compose -f docker-compose.test.yml run --rm minio-init",
    "db:test:down": "docker compose -f docker-compose.test.yml down",
    "e2e:changed": "playwright test --only-changed=origin/main"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@swc/core": "^1.16.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bcrypt": "^6.0.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/utils": "^8.70.0",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "^4.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "open": "^11",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer": "^25.11.0",
    "supertest": "^7.2.2",
    "typescript-eslint": "^8.70.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4",
    "vitest-axe": "0.1.0"
  },
  "resolutions": {
    "js-yaml": "^5.2.2",
    "typescript": "^6",
    "browserslist": "^4.28.8",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1"
  },
  "msw": {
    "workerDirectory": [
      "client-admin/public",
      "ui/.storybook/public"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
