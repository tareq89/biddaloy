/test-results/
/test-results-pwa/
/playwright-report/
/playwright-report-pwa/
/blob-report/
/playwright/.cache/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# Python bytecode from skill scripts
__pycache__/
*.pyc

# Claude Code: personal/machine-local overrides, never shared
.claude/settings.local.json
.claude/.headroom_wrap_marker.json

# design-sync (claude.ai/design) — regenerated by each sync run, never committed
.ds-sync/
ds-bundle/
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
# ui has no build step (consumed as source) — this is a scratch copy of the
# real compiled Tailwind CSS, pulled from .design-sync/sb-reference's own
# Vite build, so cfg.cssEntry has something real (but PKG_DIR-bounded) to
# point at. Regenerated by every sync; see .design-sync/NOTES.md.
ui/.design-sync-compiled.css
storybook-static/

# Playwright auth storageState files ([8.5.2]) — session cookies, never committed
e2e/.auth/
