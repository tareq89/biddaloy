%% title: From adding staff to pages by role
%% desc: The Admin adds a staff member and chooses a role. The staff member gets an invitation and activates the account. Then, by role, a teacher sees their own sections, an accountant sees fees, and office staff see admissions.
flowchart LR
  A["Admin<br/>adds staff"]:::admin --> I["Invitation"]:::note
  I --> S["Staff<br/>signs in"]
  S --> T["Teacher<br/>own sections"]:::teacher
  S --> F["Accountant<br/>fees, payments"]:::admin
  S --> O["Office staff<br/>admissions"]
  classDef teacher fill:#e7f5ff,stroke:#1c7ed6,color:#0b3d66
  classDef admin fill:#fff4e6,stroke:#e8590c,color:#7a2e05
  classDef guardian fill:#ebfbee,stroke:#2b8a3e,color:#14411d
  classDef note fill:#f1f3f5,stroke:#868e96,color:#343a40
