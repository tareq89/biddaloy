%% title: A day at school
%% desc: A teacher takes attendance. The dashboard and an alert show school leaders which sections are left. The accountant sees dues. If a fee is overdue, the guardian is told.
flowchart TB
  T["Teacher<br/>takes attendance"]:::teacher --> D["Dashboard<br/>sections left"]:::sys
  D -.-> L["Admin<br/>sees the alert"]:::admin
  P["Accountant<br/>sees dues"]:::admin --> G["Guardian<br/>told of dues"]:::guardian
  classDef teacher fill:#e7f5ff,stroke:#1c7ed6,color:#0b3d66
  classDef admin fill:#fff4e6,stroke:#e8590c,color:#7a2e05
  classDef guardian fill:#ebfbee,stroke:#2b8a3e,color:#14411d
  classDef sys fill:#f1f3f5,stroke:#868e96,color:#343a40
