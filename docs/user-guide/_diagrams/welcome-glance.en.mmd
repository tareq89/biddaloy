%% title: SchoolManager at a glance
%% desc: Teachers record attendance and marks. The accountant records fee collection. The admin sees the state of the school. Guardians and students are told what matters to them.
flowchart TB
  T["Teacher<br/>attendance, marks"]:::teacher --> S["SchoolManager"]:::sys
  A["Accountant<br/>fee collection"]:::admin --> S
  M["Admin<br/>school overview"]:::admin --> S
  S -.-> G["Guardian<br/>alerts"]:::guardian
  S -.-> ST["Student<br/>reminders"]:::guardian
  classDef teacher fill:#e7f5ff,stroke:#1c7ed6,color:#0b3d66
  classDef admin fill:#fff4e6,stroke:#e8590c,color:#7a2e05
  classDef guardian fill:#ebfbee,stroke:#2b8a3e,color:#14411d
  classDef sys fill:#f1f3f5,stroke:#868e96,color:#343a40
