%% title: What opens depends on how many sections you have
%% desc: Choosing My class counts your sections in the current academic year. With none, an empty message shows. With one, that section's page opens directly. With two or more, section cards let you pick.
flowchart TD
  M["My class"]:::teacher --> Q{"How many sections?"}:::note
  Q -->|"0"| E["No section yet"]:::note
  Q -->|"1"| S["Section page<br/>opens directly"]:::teacher
  Q -->|"2 or more"| P["Pick a section"]:::teacher
  P --> S
  classDef teacher fill:#e7f5ff,stroke:#1c7ed6,color:#0b3d66
  classDef admin fill:#fff4e6,stroke:#e8590c,color:#7a2e05
  classDef guardian fill:#ebfbee,stroke:#2b8a3e,color:#14411d
  classDef note fill:#f1f3f5,stroke:#868e96,color:#343a40
