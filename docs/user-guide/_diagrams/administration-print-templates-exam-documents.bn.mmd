%% title: পরীক্ষার কাগজ: কোনটির আগে কী লাগে
%% desc: পরীক্ষার কাগজ তিন ভাগে। পরীক্ষার আগে প্রবেশপত্র আর রুটিন নোটিশ; প্রবেশপত্রের জন্য প্রকাশিত সিট প্ল্যান আর রুটিনের জন্য সময়সূচি লাগে। পরীক্ষার হলে সিট লিস্ট, ইনভিজিলেটর শিট আর সিট স্টিকার, এগুলোর জন্য প্রকাশিত সিট প্ল্যান লাগে; ফাঁকা নম্বর-শিটের জন্য নম্বর বিভাজন লাগে। ফলের পর টেবুলেশনের জন্য ফল প্রক্রিয়া করা লাগে; মার্কশিট, ফলাফল সনদ আর মেধা সনদের জন্য ফল প্রকাশ লাগে।
flowchart LR
  subgraph B["পরীক্ষার আগে"]
    direction TB
    B1["প্রবেশপত্র<br/>প্রকাশিত সিট প্ল্যান"]:::admin
    B2["রুটিন নোটিশ<br/>সময়সূচি"]:::admin
    B1 ~~~ B2
  end
  subgraph H["পরীক্ষার হলে"]
    direction TB
    H1["সিট লিস্ট<br/>প্রকাশিত সিট প্ল্যান"]
    H2["ইনভিজিলেটর শিট<br/>প্রকাশিত সিট প্ল্যান"]
    H3["সিট স্টিকার<br/>প্রকাশিত সিট প্ল্যান"]
    H4["নম্বর-শিট<br/>নম্বর বিভাজন"]
    H1 ~~~ H2
    H2 ~~~ H3
    H3 ~~~ H4
  end
  subgraph A["ফলের পর"]
    direction TB
    A1["টেবুলেশন<br/>ফল প্রক্রিয়া হয়েছে"]:::done
    A2["মার্কশিট<br/>ফল প্রকাশিত"]:::done
    A3["ফলাফল সনদ<br/>ফল প্রকাশিত"]:::done
    A4["মেধা সনদ<br/>ফল প্রকাশিত"]:::done
    A1 ~~~ A2
    A2 ~~~ A3
    A3 ~~~ A4
  end
  B ~~~ H
  H ~~~ A
  classDef admin fill:#fff4e6,stroke:#e8590c,color:#7a2e05
