%% title: From dashboard to page
%% desc: The dashboard shows widgets. Each widget shows one number and links to the page where you act on it. Alerts tell you when a number needs attention.
flowchart LR
  D["Dashboard"]:::sys --> W["Widget<br/>one number"]:::teacher
  W --> P["Page<br/>where you act"]:::admin
  A["Alert"]:::sys -.-> D
  classDef teacher fill:#e7f5ff,stroke:#1c7ed6,color:#0b3d66
  classDef admin fill:#fff4e6,stroke:#e8590c,color:#7a2e05
  classDef sys fill:#f1f3f5,stroke:#868e96,color:#343a40
