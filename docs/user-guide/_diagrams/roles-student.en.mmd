%% title: Student: who does what
%% desc: News from the Teacher, Admin, Exam controller and Accountant reaches the student on the portal; the student sends applications to the school.
flowchart LR
  stu["Student"]:::me
  tea["Teacher"]
  por["Portal<br/>(guardian,<br/>student)"]:::view
  admin["Admin"]
  exam["Exam<br/>controller"]
  acc["Accountant"]
  off["Office<br/>staff"]
  tea -->|"Attendance, homework, syllabus"| por
  admin -->|"Routine"| por
  exam -->|"Schedule, results"| por
  acc -->|"Fee bills"| por
  por -->|"All news"| stu
  stu -->|"Applications"| off
  classDef me fill:#e7f5ff,stroke:#1c7ed6,color:#0b3d66
  classDef view fill:#ebfbee,stroke:#2b8a3e,color:#14411d
