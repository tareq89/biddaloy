%% title: Sign-in paths
%% desc: You can sign in with a password or a code. The first time, a card asks you to set a password. Then one school goes straight in, and several schools ask you to choose.
flowchart LR
  S["Sign in<br/>page"] --> P["Password"]
  S --> C["Code"]
  P --> F["First time?<br/>Password card"]:::note
  C --> F
  F --> O["One school<br/>Straight in"]:::done
  F --> M["Several schools<br/>Choose one"]
  M --> O
  classDef note fill:#f1f3f5,stroke:#868e96,color:#343a40
  classDef done fill:#ebfbee,stroke:#2b8a3e,color:#14411d
