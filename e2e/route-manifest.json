{
  "$comment": "[8.5.3] Every navigable route in client-admin. `role` is the seed-contract role specs log in with; `archetype` names the ui/src/shells building block (or 'bespoke'); `overlays` are named dialog/drawer states for the 8.5.5 visual suite. Drift-guarded by client-admin/src/route-manifest.test.ts against routeTree.gen.ts.",
  "routes": [
    {
      "path": "/",
      "role": "admin",
      "archetype": "redirect"
    },
    {
      "path": "/login",
      "role": "guest",
      "archetype": "bespoke"
    },
    {
      "path": "/select-school",
      "role": "admin",
      "archetype": "bespoke"
    },
    {
      "path": "/dashboard",
      "role": "admin",
      "archetype": "bespoke"
    },
    {
      "path": "/settings",
      "role": "admin",
      "archetype": "form"
    },
    {
      "path": "/academic-years",
      "role": "admin",
      "archetype": "list"
    },
    {
      "path": "/academic-years/$academicYearId",
      "params": {
        "academicYearId": "seeded"
      },
      "role": "admin",
      "archetype": "detail"
    },
    {
      "path": "/classes",
      "role": "admin",
      "archetype": "list"
    },
    {
      "path": "/classes/$classId",
      "params": {
        "classId": "seeded"
      },
      "role": "admin",
      "archetype": "detail"
    },
    {
      "path": "/audit-logs",
      "role": "admin",
      "archetype": "list"
    },
    {
      "path": "/fees",
      "role": "accountant",
      "archetype": "bespoke"
    },
    {
      "path": "/fees/dues",
      "role": "accountant",
      "archetype": "list",
      "overlays": ["send-reminder", "generate-invoices"]
    },
    {
      "path": "/fees/generate",
      "role": "accountant",
      "archetype": "wizard"
    },
    {
      "path": "/guardians",
      "role": "admin",
      "archetype": "list"
    },
    {
      "path": "/fee-structures",
      "role": "admin",
      "archetype": "list",
      "overlays": ["create-structure"]
    },
    {
      "path": "/guardians/$guardianId",
      "params": {
        "guardianId": "seeded"
      },
      "role": "admin",
      "archetype": "detail"
    },
    {
      "path": "/staff",
      "role": "admin",
      "archetype": "list"
    },
    {
      "path": "/staff/$userId",
      "params": {
        "userId": "seeded"
      },
      "role": "admin",
      "archetype": "detail"
    },
    {
      "path": "/invoices",
      "role": "accountant",
      "archetype": "list"
    },
    {
      "path": "/invoices/$invoiceId",
      "params": {
        "invoiceId": "seeded"
      },
      "role": "accountant",
      "archetype": "detail"
    },
    {
      "path": "/payments/record",
      "role": "accountant",
      "archetype": "wizard"
    },

    {
      "path": "/communications/send",
      "role": "admin",
      "archetype": "form",
      "overlays": ["confirm-send"]
    },

    {
      "path": "/communications/reminders",
      "role": "accountant",
      "archetype": "form"
    },
    {
      "path": "/communications/batches",
      "role": "accountant",
      "archetype": "list"
    },
    {
      "path": "/communications/batches/$batchId",
      "params": {
        "batchId": "seeded"
      },
      "role": "accountant",
      "archetype": "detail"
    },
    {
      "path": "/students",
      "role": "admin",
      "archetype": "list",
      "overlays": ["send-reminder"]
    },
    {
      "path": "/students/new",
      "role": "admin",
      "archetype": "form"
    },
    {
      "path": "/students/import",
      "role": "admin",
      "archetype": "bespoke"
    },
    {
      "path": "/students/$studentId",
      "params": {
        "studentId": "seeded"
      },
      "role": "admin",
      "archetype": "detail",
      "overlays": ["send-reminder", "delete-student", "transfer-status"]
    },
    {
      "path": "/students/$studentId/edit",
      "params": {
        "studentId": "seeded"
      },
      "role": "admin",
      "archetype": "form"
    },
    {
      "path": "/portal",
      "role": "parent",
      "archetype": "bespoke"
    },
    {
      "path": "/portal/fees",
      "role": "parent",
      "archetype": "list"
    },
    {
      "path": "/portal/account",
      "role": "parent",
      "archetype": "form"
    }
  ]
}
