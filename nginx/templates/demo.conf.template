# demo.<domain> (Epic 79.0). DEMO_DOMAIN comes from the edge .env (`*.invalid` when unset,
# so nothing matches). `demo-app` is the alias deploy/stack.yml gives the demo app on the
# `biddaloy-edge` network. The demo is public (no outer login) but never indexed.

upstream demo_upstream {
    zone demo_upstream 256k;
    server demo-app:3000 resolve;
}

server {
    listen 80;
    include /etc/nginx/snippets/edge-server.conf;
    access_log /var/log/nginx/access.log redacted;
    server_name ${DEMO_DOMAIN};

    client_max_body_size 55M;
    add_header Strict-Transport-Security $edge_hsts always;

    # The app already sends noindex in DEMO_MODE; hide it so the header appears once.
    proxy_hide_header X-Robots-Tag;
    add_header X-Robots-Tag "noindex, nofollow" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $edge_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 60s;

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # Readiness names the failing dependency: internal only, as on prod.
    location ~ ^/api/health/ready/?$ {
        return 404;
    }

    # Same limits as the app: backup validate takes up to 64 MB, assets are content-hashed.
    location = /api/v1/backup/validate {
        client_max_body_size 70M;
        proxy_read_timeout 300s;
        proxy_pass http://demo_upstream;
    }

    location ~ ^/assets/ {
        proxy_pass http://demo_upstream;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Strict-Transport-Security $edge_hsts always;
    }

    location / {
        proxy_pass http://demo_upstream;
    }
}
