# Secret-bearing URLs: log the path without its query string (?token=...),
# mask path tokens, and never log the Referer (a page opened from a
# reset/invite link sends that link as Referer on every asset request).
# `$lg_keep` is nginx-only: the image's envsubst step substitutes only
# variables defined in the container env (the same reason `$host` survives).
map $uri $log_uri {
    default $uri;
    # API paths, plus the SPA share/verify pages people actually open:
    # /i/<token> (invoice share) and /v/<token> (certificate verify), /n/<token> (notice link); Kuma /api/push/<token>.
    "~^(?<lg_keep>/[ivn]/|.*/(?:public/invoices|public/verify|public/notices|calendar/feed|api/push)/)" "${lg_keep}[REDACTED]";
}
log_format redacted '$remote_addr - [$time_local] "$request_method $log_uri" '
                    '$status $body_bytes_sent "$http_user_agent" $request_time';

# Two app containers (D25), restarted one at a time. The names are the aliases
# deploy/stack.yml gives `app` / `app2` on the `biddaloy-edge` network. `resolve` looks the
# names up again every few seconds, so nginx boots (and keeps serving) when one is missing
# or restarting; a refused connection falls through to the other one.
upstream app_upstream {
    zone app_upstream 256k;
    server prod-app:3000 max_fails=1 fail_timeout=5s resolve;
    server prod-app2:3000 max_fails=1 fail_timeout=5s resolve;
}

# Unknown Host/SNI: answer nothing. Must be the default on every port so a scan of the
# bare IP (or a DNS-history lookup) never reaches the app. Port 443 exists in direct mode
# only; edge-default.conf adds it.
server {
    listen 80 default_server;
    include /etc/nginx/snippets/edge-default.conf;
    access_log /var/log/nginx/access.log redacted;
    # Loopback-only liveness for the container healthcheck ([75.29]).
    # $realip_remote_addr = the TCP peer, so a CF-Connecting-IP header
    # can never fake it.
    location = /healthz {
        access_log off;
        if ($realip_remote_addr !~ "^(127\.0\.0\.1|::1)$") { return 444; }
        default_type text/plain;
        return 200 "ok\n";
    }
    location / { return 444; }
}

# The app. Port 80 in both modes; direct mode adds 443, ACME and the :80 redirect
# (edge-server.conf, written by edge-mode.sh).
server {
    listen 80;
    include /etc/nginx/snippets/edge-server.conf;
    access_log /var/log/nginx/access.log redacted;
    server_name ${APP_DOMAIN};

    # Must cover the largest legal upload: homework submission, 10 files x 5 MB.
    # server/src/nginx-body-limit.spec.ts fails if this falls below a route's
    # own limit. Each route still enforces its own per-file limit in the app.
    client_max_body_size 55M;
    add_header Strict-Transport-Security $edge_hsts always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $edge_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 60s;
    proxy_next_upstream error timeout http_502 http_503;

    # [15.1.3]: readiness is internal-only — it names which dependency
    # (db/redis/queue) is down, which is useful to an uptime monitor
    # reaching the app container directly but not to the public internet.
    # A bare 404 here, not a proxied 401/403, so the route's existence
    # isn't even disclosed. Must sit above the generic /api/ block below,
    # since nginx picks the most specific matching `location`.
    location = /api/health/ready {
        return 404;
    }

    location = /api/health/ready/ {
        return 404;
    }

    location = /api/health {
        proxy_pass http://app_upstream;
    }

    # Backup validate takes a file up to BACKUP_MAX_UPLOAD_BYTES (64 MB); every other
    # route keeps the server-wide cap. Validation of a 10k-student file is slow.
    location = /api/v1/backup/validate {
        client_max_body_size 70M;
        proxy_read_timeout 300s;
        proxy_pass http://app_upstream;
    }

    # [Epic 98, D17] Cockpit-only routes: the app host refuses them (404, never a proxied 401).
    location ^~ /api/v1/platform/alerts {
        return 404;
    }

    location ^~ /api/v1/auth/cockpit/ {
        return 404;
    }

    location /api/ {
        proxy_pass http://app_upstream;
    }

    # [Epic 40, #3620, D33] Theme demo: the site container renders a theme's own sample content
    # when it sees X-Site-Preview (set here, and dropped on the school listener, site.conf.template).
    # nginx lets only a lowercase name through (else 404); the site middleware checks it is a real
    # theme. No cookie goes either way.
    location ^~ /website/preview/ {
        # A matching rewrite ... break stops here; any other name (/website/preview/Bad_1/)
        # reaches the return and never the site container.
        # #3681: a bare theme lands on /bn/; a language segment (bn|en) keeps its own path
        # (the old single rewrite turned /en/ into /bn/en/); any other segment is a 404.
        rewrite ^/website/preview/([a-z-]+)/?$ /bn/ break;
        rewrite ^/website/preview/([a-z-]+)/(bn|en)$ /$2/ break;
        rewrite ^/website/preview/([a-z-]+)/((?:bn|en)(?:/.*)?)$ /$2 break;
        return 404;
        # A location's own proxy_set_header replaces every inherited one, so repeat the common ones.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $edge_proto;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Site-Preview $1;
        proxy_set_header Cookie "";
        # The demo is anonymous: the site container may never set a cookie on the app host.
        proxy_hide_header Set-Cookie;
        proxy_pass http://site_upstream;
        add_header X-Robots-Tag "noindex" always;
        add_header Strict-Transport-Security $edge_hsts always;
    }

    # [#3681] The theme demo page links its own /_astro/ assets and loads the notices island from
    # /_api/island/. The SPA uses neither prefix, so on the app host the first goes to the site
    # container (hashed static files, no cookie) and the island answers 404 ("no data" to the
    # island code) instead of SPA html. Preview links to other pages are a documented limit.
    location ^~ /_astro/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $edge_proto;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Site-Preview "";
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_pass http://site_upstream;
        add_header X-Robots-Tag "noindex" always;
        add_header Strict-Transport-Security $edge_hsts always;
    }

    location ^~ /_api/island/ {
        return 404;
    }

    # Immutable, content-hashed SPA assets (Vite's dist/assets/*) — cache
    # aggressively. One SPA served at `/` since [8.9.10], so one path
    # prefix instead of one per client package (see main.ts).
    location ~ ^/assets/ {
        proxy_pass http://app_upstream;
        proxy_cache_valid 200 60m;
        # Express's static() middleware sets its own (much shorter)
        # Cache-Control; without hiding it first, add_header appends a
        # second, conflicting Cache-Control header rather than replacing it.
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security $edge_hsts always;
    }

    location / {
        proxy_pass http://app_upstream;
    }
}

# [Epic 98, D17] Cockpit host: same app, own host name, so the platform routes answer here only.
# COCKPIT_DOMAIN is `cockpit*.invalid` when unset in deploy/edge.yml (nothing matches).
server {
    listen 80;
    include /etc/nginx/snippets/edge-server.conf;
    access_log /var/log/nginx/access.log redacted;
    server_name ${COCKPIT_DOMAIN};

    client_max_body_size 1M;
    add_header Strict-Transport-Security $edge_hsts always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $edge_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 60s;
    proxy_next_upstream error timeout http_502 http_503;

    location ~ ^/api/health/ready/?$ {
        return 404;
    }

    location / {
        proxy_pass http://app_upstream;
    }
}
