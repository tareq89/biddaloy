# School websites (Epic 40, #3620): <school>.${ROOT_DOMAIN}, e.g. rumsc.schoolmanagerp.com.
#
# They live on their OWN listener, :8081, which holds nothing but this server{} and a default
# that answers 444. No fixed host (app, staging, ops, ...) is ever served here, and the school
# host is not served on :80. Why: cloudflared matches host names case-sensitively, so a name like
# STAGING.<root> skips the staging rule; the cloudflared catch-all that points at :8081 then lands
# it on a listener with no staging block, never on one that serves staging
# (runbook part 17a, docs/architecture/25-cloudflare.md). Do not add a fixed host to this file. (A fixed name that fits the one-label shape, such as
# app.<root>, would still be proxied to the site container, which answers 404: those names are in
# RESERVED_SUBDOMAINS, #3615, so no school can own them.)
# :8081 is published nowhere: only cloudflared reaches it over the `biddaloy-edge` network.
# Direct mode (D5) has no wildcard certificate here and no published port: school sites are
# tunnel-only for now, the listener still boots so both modes share one config.
#
# Production only: the upstream names are the `prod-*` aliases (deploy/stack.yml), as in
# default.conf.template. No cookie ever reaches the site container (it is anonymous), and
# X-Site-Preview is dropped on every public request (the site container trusts that header,
# only the app-host preview route in default.conf.template may set it).

proxy_cache_path /var/cache/nginx/site levels=1:2 keys_zone=site_cache:10m max_size=200m inactive=2h;

upstream site_upstream {
    zone site_upstream 256k;
    server prod-site:4321 max_fails=1 fail_timeout=5s resolve;
}

# Unknown or fixed host on :8081: answer nothing (Rule 12).
server {
    listen 8081 default_server;
    access_log /var/log/nginx/access.log redacted;
    return 444;
}

server {
    listen 8081;
    access_log /var/log/nginx/access.log redacted;
    # One label of 3-30 characters (D5, SITE_SUBDOMAIN_RE) under ROOT_DOMAIN, dots escaped:
    # rumsc.schools.test matches, rumsc.schoolsXtest and ab.schools.test do not. edge-mode.sh
    # writes this server_name from ROOT_DOMAIN (envsubst cannot escape the dots).
    include /etc/nginx/snippets/site-server-name.conf;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $edge_proto;
    # Not trusted from a visitor; the site and the API read the school from Host.
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header Cookie "";
    proxy_set_header X-Site-Preview "";
    proxy_connect_timeout 2s;
    proxy_read_timeout 30s;
    # Pages are anonymous: nothing from upstream may set a cookie on a school host.
    proxy_hide_header Set-Cookie;
    # The default cache key holds the upstream name, the same for every school: add the host.
    # Known gap #3677: behind this cache the API still sees one IP (the site container) for every
    # school, so its 1200/min read limit is one shared bucket, and the host lookup is uncached.
    proxy_cache_key $host$request_uri;

    # Pages: 30 s micro-cache (D32). If the site container or the API behind it is down (no answer
    # or a 5xx), an expired page is served stale for as long as that lasts; nginx has no max-stale age. The only bound is eviction:
    # an entry nobody asked for in 2 hours (inactive=2h) is gone, and then the visitor gets the
    # maintenance page (503).
    location / {
        proxy_pass http://site_upstream;
        proxy_cache site_cache;
        proxy_cache_valid 200 30s;
        proxy_cache_valid 404 10s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        # Draft pages (?preview=<token>) are never stored or served from the cache.
        proxy_cache_bypass $arg_preview;
        proxy_no_cache $arg_preview;
        add_header X-Cache-Status $upstream_cache_status;
        add_header Strict-Transport-Security $edge_hsts always;
        error_page 502 503 504 =503 /maintenance.html;
    }

    # File shipped in the site image (site/public/maintenance.html) and mounted by deploy/edge.yml.
    location = /maintenance.html {
        internal;
        root /usr/share/nginx/site-static;
        add_header Cache-Control "no-store";
        add_header Strict-Transport-Security $edge_hsts always;
    }

    # Media: the API answers `no-store` (Rule 14); this is the one documented long-cache response.
    # Safe because a picture's key is its media id: a new picture gets a new URL. Only a 200 is
    # cached (1 day on the nginx side). A location's own proxy_hide_header replaces the server's,
    # so Set-Cookie is hidden again here; a response that sets a cookie is never stored.
    # Accepted (D41): a deleted picture or a switched-off site keeps answering from here for up
    # to 1 day, and from browsers for up to a year. There is no purge.
    location /media/ {
        rewrite ^/media/(.+)$ /api/v1/public/site/by-host/$host/media/$1 break;
        proxy_pass http://app_upstream;
        proxy_hide_header Cache-Control;
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Cache-Control Expires;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security $edge_hsts always;
        proxy_cache site_cache;
        proxy_cache_valid 200 1d;
    }

    # The logo is NOT keyed by content: every page links the same /media/logo
    # (page-read-model.ts), so a new logo keeps that URL. Short cache, never immutable.
    location = /media/logo {
        rewrite ^ /api/v1/public/site/by-host/$host/media/logo break;
        proxy_pass http://app_upstream;
        proxy_hide_header Cache-Control;
        proxy_hide_header Set-Cookie;
        proxy_ignore_headers Cache-Control Expires;
        add_header Cache-Control "public, max-age=300";
        add_header Strict-Transport-Security $edge_hsts always;
        proxy_cache site_cache;
        proxy_cache_valid 200 1m;
    }

    # Islands (D21): straight to the by-host API, never cached. rewrite keeps the query string.
    location /_api/ {
        rewrite ^/_api/(.*)$ /api/v1/public/site/by-host/$host/$1 break;
        proxy_pass http://app_upstream;
        add_header Strict-Transport-Security $edge_hsts always;
    }
}
