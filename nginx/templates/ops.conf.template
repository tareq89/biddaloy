# Ops UIs (deploy/ops.yml), one hostname each at `/`: KUMA_DOMAIN, BESZEL_DOMAIN, LOGS_DOMAIN
# (all `*.invalid` when unset). Not rendered when OPS_UPSTREAM_HOST is empty: ops runs on
# another host then (reload-loop.sh removes conf.d/ops.conf).
#
# Two login layers (D14). Outer: tunnel mode = Cloudflare Access, checked by cloudflared;
# direct mode = basic auth here ($basic_auth, off in tunnel mode). Inner: each tool's own.
# The one exception is Kuma's push endpoint: the VM's own timers post job results to it
# with a token in the URL and cannot answer a login.
#
# Upstreams use `resolve` (Docker's DNS), so nginx still boots when the ops stack is down.
# nginx meets the UIs on the `biddaloy-ops-edge` network.
map $http_upgrade $ops_connection {
    default upgrade;
    ''      close;
}

upstream kuma_upstream {
    zone kuma_upstream 256k;
    server uptime-kuma:3001 resolve;
}

upstream beszel_upstream {
    zone beszel_upstream 256k;
    server beszel:8090 resolve;
}

upstream dozzle_upstream {
    zone dozzle_upstream 256k;
    server dozzle:8080 resolve;
}

server {
    listen 80;
    include /etc/nginx/snippets/edge-server.conf;
    access_log /var/log/nginx/access.log redacted;
    server_name ${KUMA_DOMAIN};

    auth_basic $basic_auth;
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    # Websocket upgrade (Kuma socket.io) and long reads so a live view is not cut at 60 s.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $ops_connection;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_buffering off;

    location / {
        proxy_pass http://kuma_upstream;
    }

    # D14: job results are pushed here by the VM's timers; the token in the URL is the login.
    location ^~ /api/push/ {
        auth_basic off;
        proxy_pass http://kuma_upstream;
    }
}

server {
    listen 80;
    include /etc/nginx/snippets/edge-server.conf;
    access_log /var/log/nginx/access.log redacted;
    server_name ${BESZEL_DOMAIN};

    auth_basic $basic_auth;
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    # Websocket upgrade (Beszel realtime) and long reads.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $ops_connection;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_buffering off;

    location / {
        proxy_pass http://beszel_upstream;
    }
}

server {
    listen 80;
    include /etc/nginx/snippets/edge-server.conf;
    access_log /var/log/nginx/access.log redacted;
    server_name ${LOGS_DOMAIN};

    auth_basic $basic_auth;
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    # Dozzle log stream (websocket / SSE) and long reads so a live tail is not cut at 60 s.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $ops_connection;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_buffering off;

    location / {
        proxy_pass http://dozzle_upstream;
    }
}
