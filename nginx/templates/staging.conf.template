# staging.<domain> (Epic 79.0). STAGING_DOMAIN comes from the edge .env (`*.invalid` when unset,
# so nothing matches). `staging-app` is the alias deploy/stack.yml gives staging's app on
# the `biddaloy-edge` network. `resolve` keeps nginx booting while staging is down (a 502
# until it is up), the same way as the app upstream.
#
# Two login layers (D14). Outer: tunnel mode = Cloudflare Access, checked by cloudflared
# before the request arrives; direct mode = basic auth here ($basic_auth, off in tunnel
# mode). Inner: the app's own login.

upstream staging_upstream {
    zone staging_upstream 256k;
    server staging-app:3000 resolve;
}

server {
    listen 80;
    include /etc/nginx/snippets/edge-server.conf;
    access_log /var/log/nginx/access.log redacted;
    server_name ${STAGING_DOMAIN};

    auth_basic $basic_auth;
    auth_basic_user_file /etc/nginx/auth/htpasswd;

    client_max_body_size 55M;

    # The app already sends noindex in DEMO_MODE; hide it so the header appears once.
    proxy_hide_header X-Robots-Tag;
    add_header X-Robots-Tag "noindex, nofollow" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $edge_proto;
    proxy_set_header X-Forwarded-Host $host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 60s;

    # Readiness names the failing dependency: internal only, as on prod.
    location ~ ^/api/health/ready/?$ {
        return 404;
    }

    # Same limits as the app: backup validate takes up to 64 MB, assets are content-hashed.
    location = /api/v1/backup/validate {
        client_max_body_size 70M;
        proxy_read_timeout 300s;
        proxy_pass http://staging_upstream;
    }

    location ~ ^/assets/ {
        proxy_pass http://staging_upstream;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location / {
        proxy_pass http://staging_upstream;
    }
}
