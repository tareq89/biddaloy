# Landing site (Epic 50 #2730, Epic 79.0): schoolmanagerp.com + www. The static files live
# in the `landing` image (its own nginx on :80, which also owns the CSP and cache headers,
# W2.02); the edge only proxies to it and redirects www to the apex. LANDING_DOMAIN comes
# from the edge .env; `landing.invalid` (compose default) never resolves, so an unset value
# matches nothing. No /api, no cookies: nothing here can serve tenant data (rule 14).

# Redirect target without ${LANDING_DOMAIN}: where the variable is unset (the other infra
# tests) envsubst leaves it literal, and nginx reads it in `return` as an unknown variable
# and fails `nginx -t`. server_name has already matched, so $host is apex or www.apex.
map $host $landing_apex {
    "~^www\.(?<a>.+)$"       $a;
    default                  $host;
}

upstream landing_upstream {
    zone landing_upstream 256k;
    server landing:80 resolve;
}

# www -> apex.
server {
    listen 80;
    include /etc/nginx/snippets/edge-server.conf;
    access_log /var/log/nginx/access.log redacted;
    server_name www.${LANDING_DOMAIN};

    # In a location so the ACME challenge path (direct mode) is still served for www.
    location / {
        return 301 https://$landing_apex$request_uri;
    }
}

server {
    listen 80;
    include /etc/nginx/snippets/edge-server.conf;
    access_log /var/log/nginx/access.log redacted;
    server_name ${LANDING_DOMAIN};

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $edge_proto;

    location / {
        proxy_pass http://landing_upstream;
    }
}
