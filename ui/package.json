{
  "name": "@biddaloy/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared React component package consumed by every Biddaloy SPA.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./shells": "./src/shells/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./routes": "./src/routes/index.ts",
    "./utils": "./src/utils/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./api": "./src/api/index.ts",
    "./test": "./src/test/index.ts",
    "./mocks": "./src/test/msw/enable-mocking.ts",
    "./styles": "./src/styles/globals.css",
    "./tailwind": "./tailwind.preset.ts",
    "./eslint-config": "./eslint-config.mjs"
  },
  "scripts": {
    "lint": "tsc --noEmit && eslint .",
    "check:exports": "node scripts/check-exports.mjs",
    "check:contrast": "node --experimental-strip-types scripts/check-contrast.mjs",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n-keys.mjs",
    "check:api-types": "node scripts/check-api-types.mjs",
    "api:types": "npx --yes openapi-typescript@7.13.0 ../server/openapi.json -o src/api/schema.d.ts",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@biddaloy/shared": "0.1.0",
    "@hookform/resolvers": "^5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26",
    "i18next-resources-to-backend": "^1",
    "lucide-react": "^1.31",
    "radix-ui": "^1.6.7",
    "react-hook-form": "^7",
    "react-i18next": "^17",
    "react-router": "^8.3.0",
    "sonner": "^1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8",
    "@storybook/addon-essentials": "^8",
    "@storybook/addon-interactions": "^8",
    "@storybook/blocks": "^8",
    "@storybook/react-vite": "^8",
    "@storybook/test": "^8",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "axios-mock-adapter": "^2.1.0",
    "msw": "^2",
    "msw-storybook-addon": "^2",
    "react": "^19",
    "react-dom": "^19",
    "storybook": "^8",
    "typescript": "^6",
    "vite": "^6",
    "vitest": "^3"
  }
}
