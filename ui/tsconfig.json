{
  "extends": "../tsconfig.frontend.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./.tsout/ui.tsbuildinfo",
    "emitDeclarationOnly": true,
    "outDir": "./.tsout",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["vite/client", "node"],
    "paths": {
      "@biddaloy/shared": ["../shared/src"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src",
    "src/**/*.json",
    "tailwind.preset.ts",
    "scripts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "references": [{ "path": "../shared" }]
}
