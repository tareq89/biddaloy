# cloudflared config, rendered by the deploy (W3.01) into ${EDGE_DIR}/cloudflared/config.yml.
# The credentials file (secret, from infra/secrets/edge.enc.env) sits next to it.
# Variables: tunnel_id, cf_access_team, aud, app_domain, staging_domain, demo_domain,
# landing_domain, kuma_domain, beszel_domain, logs_domain.
tunnel: {{ tunnel_id }}
credentials-file: /etc/cloudflared/credentials.json

ingress:
  # Kuma push monitors must reach Kuma without Access (D14); Kuma checks the push token itself.
  - hostname: {{ kuma_domain }}
    path: ^/api/push/
    service: http://nginx:80
  - hostname: {{ app_domain }}
    service: http://nginx:80
  - hostname: {{ landing_domain }}
    service: http://nginx:80
  - hostname: {{ demo_domain }}
    service: http://nginx:80
{% for host in [staging_domain, kuma_domain, beszel_domain, logs_domain] %}
  - hostname: {{ host }}
    service: http://nginx:80
    originRequest:
      access:
        required: true
        teamName: "{{ cf_access_team }}"
        audTag: ["{{ aud }}"]
{% endfor %}
  - service: http_status:404
