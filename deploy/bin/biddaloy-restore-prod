#!/usr/bin/env bash
# Restore a prod backup onto a fresh prod VM (Epic 79, #2802, decisions P9, D21; closes #2748).
#
#   biddaloy-restore-prod --age-key-file <path> --from <db/hourly/F.dump.age|db/daily/F.dump.age|latest-hourly|latest-daily> \
#                         --yes-restore-prod <db-name> [--skip-files] [--max-age-hours N]
#
# Run it once, after `provision` and `biddaloy-deploy all <sha>`. It restores the chosen R2 dump
# into the EMPTY prod database, copies the uploaded files back, migrates with the prod app image,
# checks counts and prints the next command. It never starts the app: you run
# `biddaloy-deploy prod <sha>` after it, which backs up, migrates, starts and smokes.
#
# Safety, in the order the script checks it. Nothing is modified until every check has passed.
#   1. The target is exactly POSTGRES_DB from /opt/biddaloy/prod/.env. There is no other target.
#   2. --yes-restore-prod must repeat that name exactly.
#   3. The age private key file must be a regular file, mode 0400 or 0600. Its path is the only
#      thing that is ever on a command line; its content is read only inside the jobs container.
#   4. The backup is chosen by you (--from) and its object age is printed. latest-* never picks a
#      dump written at or after this VM's prod database volume was made: the new VM's own `backup`
#      service would dump its empty database to the same prefix (deploy.yml holds it back while
#      prod has no user; this is the second guard). latest-* is for a dead old VM. For a planned
#      move, stop the old VM's writes and pass its final dump as an exact --from (the newest
#      skipped dump is printed).
#   5. Empty means: no user and no school except the migration-made 'default-school' (a missing
#      table counts as 0), else exit 2. restore.sh checks it again, first and inside its transaction.
#   6. The emptiness check, the wipe (DROP SCHEMA public CASCADE) and the dump load are ONE
#      transaction inside restore.sh: if anything fails, the database is exactly as it was.
# Why not restore into <prod>_next and swap: scripts/backup/db-swap.sh accepts only
# biddaloy_staging* / biddaloy_demo* names, on purpose, so it can never rename prod. The target is
# empty by check 5, so a transactional restore in place loses nothing.
#
# Locks: $ROOT/deploy.lock first, then the host swap lock (same order as biddaloy-nightly).
# Exit codes: 0 ok, 1 a step failed (state printed), 2 refused or bad usage (nothing modified).
# Secrets travel only through the environment and compose interpolation, never argv or the log.
# `set -x` is never used.
set -euo pipefail

ROOT="${BIDDALOY_ROOT:-/opt/biddaloy}"
REPO="${BIDDALOY_REPO:-$ROOT/repo}"
SWAP_LOCK="${BIDDALOY_SWAP_LOCK:-/run/lock/biddaloy-swap.lock}"
ENV_FILE="$ROOT/prod/.env"
DEPLOYS_LOG="$ROOT/prod/deploys.log"

say() { printf '%s biddaloy-restore-prod: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >&2; }
refuse() { say "REFUSED: $1"; say "Nothing was modified."; exit 2; }

KEY_FILE="" FROM="" CONFIRM="" SKIP_FILES=0 MAX_AGE_H=36
while [[ $# -gt 0 ]]; do
  case "$1" in
    --age-key-file) [[ $# -ge 2 ]] || refuse "--age-key-file needs a path"; KEY_FILE="$2"; shift 2 ;;
    --from) [[ $# -ge 2 ]] || refuse "--from needs a value"; FROM="$2"; shift 2 ;;
    --yes-restore-prod) [[ $# -ge 2 ]] || refuse "--yes-restore-prod needs the database name"; CONFIRM="$2"; shift 2 ;;
    --skip-files) SKIP_FILES=1; shift ;;
    --max-age-hours) [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || refuse "--max-age-hours needs a number"; MAX_AGE_H="$2"; shift 2 ;;
    *) refuse "unknown argument '$1' (usage: --age-key-file <path> --from <key|latest-hourly|latest-daily> --yes-restore-prod <db-name> [--skip-files])" ;;
  esac
done
[[ -n "$KEY_FILE" ]] || refuse "--age-key-file <path> is required"
[[ -n "$FROM" ]] || refuse "--from is required: db/hourly/<file>.dump.age, db/daily/<file>.dump.age, latest-hourly or latest-daily"
[[ -n "$CONFIRM" ]] || refuse "--yes-restore-prod <db-name> is required (type the prod database name again to confirm)"

# --- check 1, 2: the target name ----------------------------------------------------------------
[[ -f "$ENV_FILE" ]] || refuse "$ENV_FILE not found: is this the prod VM?"
envval() {
  local v
  v="$(sed -n "s/^$1=//p" "$ENV_FILE" | tail -1)" || true
  v="${v%\"}"; v="${v#\"}"; v="${v%\'}"; v="${v#\'}"
  printf '%s' "$v"
}
POSTGRES_DB="$(envval POSTGRES_DB)"
POSTGRES_USER="$(envval POSTGRES_USER)"
POSTGRES_PASSWORD="$(envval POSTGRES_PASSWORD)"
[[ "$POSTGRES_DB" =~ ^[a-z0-9_]+$ ]] || refuse "POSTGRES_DB in $ENV_FILE is empty or not [a-z0-9_]+"
[[ -n "$POSTGRES_USER" && -n "$POSTGRES_PASSWORD" ]] || refuse "POSTGRES_USER or POSTGRES_PASSWORD missing in $ENV_FILE"
[[ "$CONFIRM" == "$POSTGRES_DB" ]] || refuse "--yes-restore-prod must equal the prod database name from $ENV_FILE exactly"

# --- check 3: the key file ----------------------------------------------------------------------
[[ -f "$KEY_FILE" && ! -L "$KEY_FILE" ]] || refuse "age key file is not a regular file (symlinks are refused)"
KEY_MODE="$(stat -c '%a' "$KEY_FILE" 2>/dev/null || stat -f '%Lp' "$KEY_FILE")"
[[ "$KEY_MODE" == 400 || "$KEY_MODE" == 600 ]] || refuse "age key file mode is $KEY_MODE; it must be 0400 or 0600 (not readable by group or others)"
KEY_OWNER_WANT="${RESTORE_KEY_UID:-10001}"
KEY_OWNER="$(stat -c '%u' "$KEY_FILE" 2>/dev/null || stat -f '%u' "$KEY_FILE")"
[[ "$KEY_OWNER" == "$KEY_OWNER_WANT" ]] || refuse "age key file is owned by uid $KEY_OWNER; the jobs container reads it as uid $KEY_OWNER_WANT: run chown $KEY_OWNER_WANT on it"
KEY_DIR="$(cd "$(dirname "$KEY_FILE")" && pwd)"
KEY_BASE="$(basename "$KEY_FILE")"
[[ "$KEY_BASE" =~ ^[A-Za-z0-9._-]+$ ]] || refuse "age key file name must match [A-Za-z0-9._-]+"
# The whole directory is mounted into the container, so it may hold nothing but the key.
[[ "$(ls -A "$KEY_DIR")" == "$KEY_BASE" ]] || refuse "key directory $KEY_DIR holds more than the key; put the key alone in a directory such as $ROOT/prod/restore/"

# --- check 4: the backup selector ---------------------------------------------------------------
case "$FROM" in
  latest-hourly) PREFIX="db/hourly/"; PICK=latest ;;
  latest-daily) PREFIX="db/daily/"; PICK=latest ;;
  db/hourly/* | db/daily/*)
    [[ "$FROM" =~ ^db/(hourly|daily)/[A-Za-z0-9._-]+\.dump\.age$ ]] || refuse "--from key must look like db/hourly/<file>.dump.age"
    PREFIX="$FROM"; PICK=exact ;;
  *) refuse "--from must be db/hourly/<file>.dump.age, db/daily/<file>.dump.age, latest-hourly or latest-daily" ;;
esac

# --- locks (deploy lock, then swap lock) --------------------------------------------------------
exec 8>"$ROOT/deploy.lock"
flock -w 3600 8 || { say "deploy lock busy for an hour"; exit 1; }
exec 9>"$SWAP_LOCK"
flock -w 3600 9 || { say "swap lock busy for an hour"; exit 1; }

# dc: always the same project, project directory and file. The key directory is handed to compose
# by interpolation (the environment wins over .env), so the key never touches a command line.
# The file is the copy prod's last ok deploy kept (deploy.yml); before one, the checkout's.
export BACKUP_AGE_KEY_DIR="$KEY_DIR" PGPASSWORD="$POSTGRES_PASSWORD"
# shellcheck source=deploy/bin/lib.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib.sh"
STACK_YML="$(kept_file prod stack.yml deploy/stack.yml)"
dc() { docker compose -p prod --project-directory "$ROOT/prod" -f "$STACK_YML" "$@"; }
psql_db() { dc exec -T -e PGPASSWORD db psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -v ON_ERROR_STOP=1 -tAqc "$1"; }

# Prints <schools except default-school>|<users>|<current database>. A missing table counts as 0
# (query_to_xml keeps a missing table from failing at parse time). Counts only.
COUNT_SQL="SELECT (CASE WHEN to_regclass('public.schools') IS NULL THEN 0
    ELSE (xpath('/row/c/text()', query_to_xml('select count(*) c from public.schools where slug <> ''default-school''', false, true, '')))[1]::text::int END)
  || '|' || (CASE WHEN to_regclass('public.users') IS NULL THEN 0
    ELSE (xpath('/row/c/text()', query_to_xml('select count(*) c from public.users', false, true, '')))[1]::text::int END)
  || '|' || current_database()"

STATE="nothing was modified" OUTCOME=failed
LOGGED_KEY="$FROM"
# deploys.log is root:deploy 0640 (report.yml): deploy appends through sudo (it has NOPASSWD).
# A line that cannot be written is a loud warning with the line to add, never silent.
log_deploy() {
  local l
  l="$(date -u '+%Y-%m-%dT%H:%M:%SZ') prod restore $LOGGED_KEY $1"
  { printf '%s\n' "$l" >> "$DEPLOYS_LOG"; } 2>/dev/null \
    || printf '%s\n' "$l" | sudo -n tee -a "$DEPLOYS_LOG" >/dev/null 2>&1 \
    || say "WARN: could not write to $DEPLOYS_LOG; add this line by hand: $l"
}
# fail <step> <why> <next>: the FAILED at / Why / Next / State block, then exit 1.
fail() {
  say "FAILED at: $1"
  say "Why: $2"
  say "State: $STATE"
  say "Next: $3"
  [[ "$STATE" == "nothing was modified" ]] || log_deploy "$OUTCOME"
  exit 1
}

# --- check 5: the prod database is empty --------------------------------------------------------
echo "step: check-empty"
counts="$(psql_db "$COUNT_SQL")" || fail check-empty "could not read the prod database (is the db container up?)" "start the stack (biddaloy-deploy all <sha>), then run this again"
[[ "$counts" =~ ^([0-9]+)\|([0-9]+)\|([a-z0-9_]+)$ ]] || fail check-empty "unexpected answer from the database check" "nothing was changed; check the db container and run again"
n_schools="${BASH_REMATCH[1]}" n_users="${BASH_REMATCH[2]}" got_db="${BASH_REMATCH[3]}"
[[ "$got_db" == "$POSTGRES_DB" ]] || refuse "connected to database '$got_db', expected '$POSTGRES_DB'"
if [[ "$n_schools" != 0 || "$n_users" != 0 ]]; then
  say "check: schools=$n_schools users=$n_users in $POSTGRES_DB (both must be 0; the default-school the migrations make is not counted)"
  say "this VM already has prod data - you probably want a normal deploy (biddaloy-deploy prod <sha>), not a restore"
  refuse "target database is not empty"
fi

# --- choose and show the backup -----------------------------------------------------------------
echo "step: choose-backup"
listing="$(list_backups "$PREFIX")" || fail choose-backup "could not list the backup bucket" "check BACKUP_S3_* in $ENV_FILE; nothing was changed"
# aws s3 ls line: "<date> <time> <size> <name>" (UTC, TZ=UTC above). Newest = highest name (names
# are timestamps). latest-* skips anything written at or after this VM's prod database volume was
# made: those are this VM's own hourly dumps of its empty database.
if [[ "$PICK" == latest ]]; then
  # docker prints CreatedAt in the daemon's own offset, e.g. 2026-10-22T10:15:30+06:00. The shape
  # is checked first: GNU `date -d ""` would read an empty answer as today 00:00 and fail open.
  vol_created="$(docker volume inspect -f '{{.CreatedAt}}' prod_pgdata 2>/dev/null)" || vol_created=""
  [[ "$vol_created" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$ ]] \
    || fail choose-backup "could not read when this VM's prod database volume (prod_pgdata) was made" "pass an exact --from db/hourly/<file>.dump.age; nothing was changed"
  # BSD date (local runs) needs +0600, no fraction.
  bsd_created="$(printf '%s' "$vol_created" | sed -E 's/\.[0-9]+//; s/Z$/+0000/; s/([+-][0-9]{2}):([0-9]{2})$/\1\2/')"
  cutoff="$(date -u -d "$vol_created" '+%Y-%m-%d %H:%M:%S' 2>/dev/null \
    || date -j -u -f '%Y-%m-%dT%H:%M:%S%z' "$bsd_created" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" || cutoff=""
  [[ "$cutoff" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]] \
    || fail choose-backup "could not read when this VM's prod database volume (prod_pgdata) was made" "pass an exact --from db/hourly/<file>.dump.age; nothing was changed"
  say "skipping dumps written since $cutoff UTC (this VM's own prod database)"
  dumps="$(printf '%s\n' "$listing" | awk 'NF >= 4 && $4 ~ /\.dump\.age$/')"
  line="$(pick_latest "$listing" "$cutoff")"
  # A planned move (old VM still writing) has real dumps after the cutoff: name the newest, so the
  # operator can pass it as an exact --from instead of restoring older data.
  skipped="$(printf '%s\n' "$dumps" | awk -v c="$cutoff" 'NF >= 4 && ($1 " " $2) >= c' | sort -k4 | tail -1)"
  if [[ -n "$skipped" ]]; then
    read -r s_date s_time _ s_name <<<"$skipped"
    say "newest skipped: ${PREFIX}${s_name} (written $s_date $s_time UTC). If the old VM was still running (a planned move), restore that one with --from ${PREFIX}${s_name}"
  fi
else
  line="$(printf '%s\n' "$listing" | awk -v n="$(basename "$FROM")" 'NF >= 4 && $4 == n' | tail -1)"
fi
[[ -n "$line" ]] || fail choose-backup "no backup found for '$FROM' (latest-* ignores this VM's own dumps)" "list the bucket by hand and pass an exact --from; nothing was changed"
read -r b_date b_time _ b_name <<<"$line"
[[ "$b_name" =~ ^[A-Za-z0-9._-]+\.dump\.age$ ]] || fail choose-backup "unexpected object name in the listing" "nothing was changed"
if [[ "$PICK" == latest ]]; then KEY="${PREFIX}${b_name}"; else KEY="$FROM"; fi
LOGGED_KEY="$KEY"
b_epoch="$(date -u -d "$b_date $b_time" +%s 2>/dev/null || date -j -u -f '%Y-%m-%d %H:%M:%S' "$b_date $b_time" +%s 2>/dev/null || echo 0)"
[[ "$b_epoch" -gt 0 ]] || refuse "could not compute the age of $KEY ($b_date $b_time)"
age_h=$(( ($(date -u +%s) - b_epoch) / 3600 ))
say "backup: $KEY written $b_date $b_time UTC (${age_h} hours old)"
[[ "$age_h" -le "$MAX_AGE_H" ]] || refuse "$KEY is ${age_h} hours old, over the ${MAX_AGE_H} hour limit; pick a newer one or pass --max-age-hours N"
say "target: database $POSTGRES_DB (schools=0 users=0), key file $KEY_BASE in $KEY_DIR"

# --- from here the stack changes -----------------------------------------------------------------
echo "step: stop-app"
STATE="app, app2 and backup may be stopped; the database was not touched"
dc stop app app2 backup || fail stop-app "docker compose stop failed" "run: docker compose -p prod --project-directory $ROOT/prod -f $STACK_YML ps; then run this again"

echo "step: restore-db"
rc=0
dc run --rm -T --no-deps -e "BACKUP_AGE_PRIVATE_KEY_FILE=/run/age/$KEY_BASE" jobs /app/restore.sh "$KEY" @env \
  --no-migrate --require-empty --allow-live-target --expect-db "$POSTGRES_DB" || rc=$?
if [[ $rc -eq 3 ]]; then
  say "this VM already has prod data - you probably want a normal deploy (biddaloy-deploy prod <sha>), not a restore"
  STATE="the database was not changed; app, app2 and backup are stopped"
  OUTCOME=refused
  fail restore-db "restore.sh found data in the target (it checked again after the stop)" "biddaloy-deploy prod <sha> starts the stack again; this VM has prod data, so a restore is not wanted"
fi
[[ $rc -eq 0 ]] || fail restore-db "restore.sh exited $rc (download, decrypt or pg_restore failed; the restore is one transaction)" "the database is still empty: fix the cause (key, bucket, dump) and run this again; the app is stopped, run biddaloy-deploy prod <sha> to start it without data if you must"

STATE="database restored from $KEY; app, app2 and backup are stopped; a second run will refuse (not empty)"
echo "step: files"
# shellcheck disable=SC2016 # runs in the container, where these variables exist
FILES_SH='set -eu
umask 077
d="$(mktemp -d)"; trap "rm -rf \"$d\"" EXIT
export RCLONE_CONFIG="$d/rclone.conf"
pw1="$(printf "%s" "$BACKUP_RCLONE_CRYPT_PASSWORD" | rclone obscure -)"
pw2="$(printf "%s" "$BACKUP_RCLONE_CRYPT_SALT" | rclone obscure -)"
{
  printf "[src]\ntype = s3\nprovider = Other\nendpoint = %s\nregion = %s\naccess_key_id = %s\nsecret_access_key = %s\nforce_path_style = true\n\n" "$S3_ENDPOINT" "$S3_REGION" "$S3_ACCESS_KEY_ID" "$S3_SECRET_ACCESS_KEY"
  printf "[r2]\ntype = s3\nprovider = Cloudflare\nendpoint = %s\nregion = auto\nno_check_bucket = true\naccess_key_id = %s\nsecret_access_key = %s\n\n" "$BACKUP_S3_ENDPOINT" "$BACKUP_S3_ACCESS_KEY_ID" "$BACKUP_S3_SECRET_ACCESS_KEY"
  printf "[r2crypt]\ntype = crypt\nremote = r2:%s\nfilename_encryption = standard\npassword = %s\npassword2 = %s\n" "$BACKUP_S3_BUCKET" "$pw1" "$pw2"
} > "$RCLONE_CONFIG"
rclone copy r2crypt:files "src:$S3_BUCKET"'
WARNINGS=""
if [[ $SKIP_FILES -eq 1 ]]; then
  say "WARN: --skip-files: uploaded files were not restored"; WARNINGS="files skipped"
elif ! dc run --rm -T jobs sh -c "$FILES_SH"; then
  # Missing files are a warning, not a failure (a fresh school may have none).
  say "WARN: copying the uploaded files back failed or found none; copy them by hand (rclone copy r2crypt:files src:<bucket>)"
  WARNINGS="files not restored"
fi

echo "step: migrate"
rc=0
dc run --rm -T --no-deps app node server/dist/scripts/migrate.js pending || rc=$?
case "$rc" in
  0) echo "no pending migrations" ;;
  2) dc run --rm -T --no-deps app node server/dist/scripts/migrate.js run \
       || fail migrate "migrations failed on the restored data" "fix the cause, then: docker compose -p prod --project-directory $ROOT/prod -f $STACK_YML run --rm -T --no-deps app node server/dist/scripts/migrate.js run (do not re-run this restore: the database is no longer empty)" ;;
  *) fail migrate "listing pending migrations failed (exit $rc)" "fix the cause, then run migrate.js run by hand (do not re-run this restore)" ;;
esac

echo "step: verify"
counts="$(psql_db "$COUNT_SQL")" || fail verify "could not count the restored rows" "check the db container; the restore itself finished"
[[ "$counts" =~ ^([0-9]+)\|([0-9]+)\|([a-z0-9_]+)$ ]] || fail verify "unexpected answer from the count query" "check the db container; the restore itself finished"
say "restored: schools=${BASH_REMATCH[1]} users=${BASH_REMATCH[2]} in ${BASH_REMATCH[3]}"
[[ "${BASH_REMATCH[1]}" -gt 0 ]] || fail verify "the restored database has no school besides default-school" "check that '$KEY' is a prod backup; the database now holds an empty schema"

STATE="restored and migrated; app, app2 and backup are stopped"
if [[ -n "$WARNINGS" ]]; then log_deploy ok-files-missing; else log_deploy ok; fi
say "done${WARNINGS:+ (warning: $WARNINGS)}. Next: biddaloy-deploy prod <sha>   (backs up, migrates, starts the app and smokes it)"
