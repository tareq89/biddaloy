{
  "extends": "../tsconfig.frontend.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "noEmit": true,
    "rootDir": "..",
    // Without an explicit list here, TypeScript 6's automatic @types/*
    // discovery silently fails to pick up @types/node in this project
    // (confirmed via --listFiles: it loads @types/react, @types/chai,
    // etc. automatically, but never @types/node) — every `node:fs`/
    // `process`/`node:buffer` reference in a *.test.ts(x) file then
    // errors with "Cannot find name". vite/client is listed for parity
    // with src/vite-env.d.ts's triple-slash reference.
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@biddaloy/shared": ["../shared/src"],
      "@biddaloy/ui": ["../ui/src"],
      "@biddaloy/ui/components": ["../ui/src/components/index.ts"],
      "@biddaloy/ui/shells": ["../ui/src/shells/index.ts"],
      "@biddaloy/ui/hooks": ["../ui/src/hooks/index.ts"],
      "@biddaloy/ui/routes": ["../ui/src/routes/index.ts"],
      "@biddaloy/ui/utils": ["../ui/src/utils/index.ts"],
      "@biddaloy/ui/i18n": ["../ui/src/i18n/index.ts"],
      "@biddaloy/ui/api": ["../ui/src/api/index.ts"],
      "@biddaloy/ui/test": ["../ui/src/test/index.ts"],
      "@biddaloy/ui/mocks": ["../ui/src/test/msw/enable-mocking.ts"],
      "@biddaloy/ui/styles": ["../ui/src/styles/globals.css"],
      "@biddaloy/ui/tailwind": ["../ui/tailwind.preset.ts"]
    }
  },
  "include": ["src"],
  // Checked separately, against the `WebWorker` lib — see
  // `tsconfig.sw.json` for why it cannot share this program.
  "exclude": ["src/sw.ts"]
}
