# client-admin's Vite reads its env files from this folder, not the repo root.
# Copy to client-admin/.env for local dev (or export the variable in the shell
# that runs Vite).

# [44.2.01] In-app help (?) links: the GitBook base. Empty hides every (?) and F1.
# Build-time: Vite inlines it, so a build without it ships no help (#3045).
VITE_HANDBOOK_URL=https://schoolmanagerp.gitbook.io/schoolmanagerp-docs
