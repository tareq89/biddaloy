---
import { areas, areaCopy, areaId } from '../../content/features';
import type { Lang } from '../../i18n';
const { lang } = Astro.props as { lang: Lang };
const label = lang === 'bn' ? 'ফিচার সূচি' : 'Feature index';
---
<nav class="index" aria-label={label}>
  {areas.map((a, n) => <a class={`c-${a.hue}`} href={`#${areaId(n)}`}><i></i>{areaCopy(a, lang).title}</a>)}
</nav>
<style>
  .index{position:sticky;top:calc(env(safe-area-inset-top,0px) + 120px);display:grid;gap:.15rem;font-size:.9rem;align-self:start}
  .index a{text-decoration:none;color:var(--muted);padding:.35rem .6rem;border-radius:6px;display:flex;gap:.5rem;align-items:center}
  .index a:hover{background:var(--surface);color:var(--fg)}
  .index a i{width:8px;height:8px;border-radius:50%;background:var(--hue);flex:none}
  @media (max-width:860px){
    .index{position:static;display:flex;gap:.4rem;overflow-x:auto;padding:0 0 .6rem;margin-bottom:.5rem;scrollbar-width:none}
    .index a{white-space:nowrap;border:1px solid var(--line);border-radius:999px;flex:none}
  }
</style>
