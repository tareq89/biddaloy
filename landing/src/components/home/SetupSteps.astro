---
import { APP_URL, DOCS_URL, type Lang } from '../../i18n';
import { setup } from '../../content/value';
const { lang } = Astro.props as { lang: Lang };
// ponytail: WhatsApp number is a placeholder until the business number is decided (D7); same as Footer.astro.
const WA = 'https://wa.me/8801000000000';
const last = setup.steps.length - 1;
---
<section class="soft"><div class="wrap">
  <h2 class="h2 center">{setup.title[lang]}</h2>
  <p class="lead center">{setup.lead[lang]}</p>
  <div class="setup">
    {setup.steps.map((s, i) => (
      <div class="step"><div class="num">{setup.nums[i]}</div><h3>{s.title[lang]}</h3><p>{s.text[lang]}</p>
        {i === last && (
          <>
            <div class="excel"><div class="doc x"></div><span class="arr">→</span><div class="list"><span></span><span></span><span></span><span></span></div><a href={DOCS_URL} target="_blank" rel="noopener" data-ev="docs_card" data-ev-slug="excel-template">{setup.excel[lang]}</a></div>
            <div class="promise"><b>{setup.promiseB[lang]}</b> {setup.promise[lang]}</div>
          </>
        )}
      </div>
    ))}
  </div>
  <div class="ctas"><a class="btn primary lg" href={`${APP_URL}/register`} target="_blank" rel="noopener" data-ev="register_click">{setup.register[lang]}</a><a class="btn secondary lg" href={WA} target="_blank" rel="noopener" data-ev="whatsapp_click">{setup.whatsapp[lang]}</a></div>
</div></section>
<style>
  .setup{display:grid;gap:1rem;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:1.75rem}
  @media (max-width:860px){.setup{grid-template-columns:1fr}}
  .step{border:1px solid var(--line);border-radius:12px;padding:1.2rem;background:var(--bg);display:flex;flex-direction:column;gap:.5rem;min-width:0}
  .step .num{width:2rem;height:2rem;border-radius:50%;background:var(--ink);color:var(--ink-fg);display:grid;place-items:center;font-weight:700}
  .step h3{font-size:1.05rem}.step p{color:var(--muted);font-size:.95rem}
  .step .promise{margin-top:auto;background:var(--teal-t);color:var(--fg);border-radius:8px;padding:.6rem .8rem;font-size:.9rem}
  .step .promise b{color:var(--teal-ink)}
  .excel{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;margin-top:.4rem}
  .excel .doc{width:34px;height:42px;border-radius:4px;border:1px solid var(--line);background:var(--bg);position:relative}
  .excel .doc::after{content:"";position:absolute;inset:6px 6px auto 6px;height:3px;background:var(--line);box-shadow:0 7px 0 var(--line),0 14px 0 var(--line),0 21px 0 var(--line)}
  .excel .doc.x{background:var(--teal-t);border-color:var(--teal-ink)}
  .excel .arr{color:var(--muted)}
  .excel .list{border:1px solid var(--line);border-radius:6px;padding:.3rem .5rem;font-size:.7rem;display:grid;gap:2px;min-width:90px}
  .excel .list span{height:5px;border-radius:3px;background:var(--line)}
  .excel a{font-size:.85rem;margin-left:auto}
  .ctas{display:flex;gap:.7rem;flex-wrap:wrap;justify-content:center;align-items:center;margin-top:1.5rem}
</style>
