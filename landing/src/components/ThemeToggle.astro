---
import { useTranslations, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<button class="pill" id="themeBtn" type="button" aria-label={t('theme.toggle')}>☾</button>
<script is:inline>
  (function () {
    var b = document.getElementById('themeBtn'), r = document.documentElement;
    function paint() { b.textContent = r.dataset.theme === 'dark' ? '☀' : '☾'; }
    paint();
    b.addEventListener('click', function () {
      var d = r.dataset.theme === 'dark' ? 'light' : 'dark';
      r.dataset.theme = d;
      document.querySelector('meta[name="theme-color"]').setAttribute('content', d === 'dark' ? '#191919' : '#ffffff');
      try { localStorage.setItem('sm:theme', d); } catch (e) {}
      paint();
    });
  })();
</script>
