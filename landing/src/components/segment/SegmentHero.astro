---
import { APP_URL, DEMO_URL, type Lang } from '../../i18n';
import type { Segment } from '../../content/segments';
interface Props { lang: Lang; seg: Segment }
const { lang, seg } = Astro.props;
const bn = lang === 'bn';
---
<section class="hero center">
  <div class="wrap">
    <h1>{seg.h1[lang]}</h1>
    <p class="sub">{seg.sub[lang]}</p>
    <div class="ctas">
      <a class="btn primary lg" href={`${APP_URL}/register`} target="_blank" rel="noopener">{bn ? 'ফ্রি অ্যাকাউন্ট খুলুন' : 'Open a free account'}</a>
      <a class="btn secondary lg" href={DEMO_URL} target="_blank" rel="noopener">{bn ? '▶ ডেমো স্কুলে ঢুকুন' : '▶ Enter the demo school'}</a>
      <span class="tiny">{bn ? '৩১ ডিসেম্বর ২০২৬ পর্যন্ত সব ছাত্র ফ্রি · কোনো কার্ড লাগে না' : 'Free for every student until 31 December 2026 · no card needed'}</span>
    </div>
  </div>
</section>

<style>
  /* from docs/architecture/assets/landing-mockup/landing-mockup-v5.html */
  section{padding-block:4rem}
  .center{text-align:center}
  .hero{padding-block:4.5rem 2rem}
  .hero h1{font-size:clamp(2.1rem,5.2vw,3.9rem);max-width:22ch;margin:0 auto 1rem;letter-spacing:-.02em}
  .hero .sub{font-size:clamp(1.02rem,1.5vw,1.2rem);color:var(--muted);max-width:60ch;margin:0 auto 1.6rem}
  .ctas{display:flex;gap:.7rem;flex-wrap:wrap;justify-content:center;align-items:center}
  .ctas .tiny{font-size:.85rem;color:var(--muted);width:100%;text-align:center}
</style>
