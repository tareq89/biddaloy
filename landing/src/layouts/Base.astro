---
import '../styles/tokens.css';
import '../styles/base.css';
import { useTranslations, LANGS, type Lang } from '../i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBar from '../components/ConsentBar.astro';
import Analytics from '../components/Analytics.astro';
import ChatFacade from '../components/ChatFacade.astro';

interface Props { lang: Lang; title?: string; description?: string; noindex?: boolean }
const { lang, title, description, noindex } = Astro.props;
const t = useTranslations(lang);
const rest = Astro.url.pathname.replace(/^\/(bn|en)(?=\/|$)/, '');
const alt = (l: string) => new URL(`/${l}${rest}`, Astro.site).href;
const pageTitle = title ? `${title} · ${t('site.title')}` : t('site.title');
const desc = description ?? t('site.description');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem('sm:theme');
          var dark = s === 'dark' || (s !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) {
            document.documentElement.dataset.theme = 'dark';
            document.querySelector('meta[name="theme-color"]').setAttribute('content', '#191919');
          }
        } catch (e) {}
      })();
    </script>
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={alt(l)} />)}
    <link rel="alternate" hreflang="x-default" href={alt('bn')} />
    <link rel="canonical" href={alt(lang)} />
    <script is:inline>
      // Web fonts (font-display: optional). A first-ever visit keeps the system font for the whole page, so
      // nothing paints, then re-wraps. After first paint we only prefetch the files and set a flag; the next
      // page (flag set, files cached) links fonts.css right here in the head, so the font is there at first paint.
      (function () {
        function css() {
          var l = document.createElement('link');
          l.rel = 'stylesheet';
          l.href = '/fonts/fonts.css';
          l.setAttribute('blocking', 'render');
          document.head.appendChild(l);
        }
        function prefetch() {
          [400, 500, 600, 700].forEach(function (w) {
            ['bengali', 'latin'].forEach(function (s) {
              var l = document.createElement('link');
              l.rel = 'prefetch';
              l.as = 'font';
              l.type = 'font/woff2';
              l.crossOrigin = 'anonymous';
              l.href = '/fonts/hind-siliguri-' + w + '-' + s + '.woff2';
              document.head.appendChild(l);
            });
          });
          try { localStorage.setItem('sm:wf', '1'); } catch (e) {}
        }
        try {
          if (localStorage.getItem('sm:wf')) { css(); return; }
          new PerformanceObserver(function (list, o) {
            if (list.getEntriesByName('first-contentful-paint').length) { o.disconnect(); prefetch(); }
          }).observe({ type: 'paint', buffered: true });
        } catch (e) { addEventListener('load', prefetch); }
      })();
    </script>
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">{t('skip')}</a>
    <Header lang={lang} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <ConsentBar lang={lang} />
    <ChatFacade lang={lang} />
    <script>import '../scripts/events';</script>
  </body>
</html>
