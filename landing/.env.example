# Build-time (PUBLIC_*) ids for the landing site. All optional; a missing id turns that feature off.
PUBLIC_UMAMI_ID=
PUBLIC_UMAMI_SRC=https://stats.schoolmanagerp.com/script.js
# Clarity project id; loads only after the visitor allows statistics.
PUBLIC_CLARITY_ID=
# Meta Pixel id; loads only after the visitor allows ads.
PUBLIC_META_PIXEL_ID=
# Digits only, country code first, e.g. 8801XXXXXXXXX. Falls back to company.whatsapp.
PUBLIC_WA_NUMBER=
# aipraktor site id for the chat widget. Empty = the chat button opens WhatsApp.
PUBLIC_AIPRAKTOR_SITE=
