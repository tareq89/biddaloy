{
  "name": "@biddaloy/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "tsc -b tsconfig.lint.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:changed": "vitest run --config vitest.unit.config.ts --changed origin/main",
    "test:integration": "vitest run 'integration.spec.ts' --exclude '**/demo-seed.coverage.integration.spec.ts' --reporter=verbose${CI_TIMINGS_OUT:+ --reporter=json --outputFile.json=$CI_TIMINGS_OUT} && vitest run src/scripts/demo-seed/demo-seed.coverage.integration.spec.ts --reporter=verbose",
    "test:e2e": "vitest run 'e2e-spec.ts' --reporter=verbose${CI_TIMINGS_OUT:+ --reporter=json --outputFile.json=$CI_TIMINGS_OUT}",
    "test:file": "vitest run",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migrate:dist": "node dist/scripts/migrate.js",
    "migrate:pending": "node dist/scripts/migrate.js pending",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:demo": "ts-node src/scripts/demo-seed/index.ts",
    "load:seed": "ts-node src/scripts/load/seed-load-10k.ts",
    "db:clear": "ts-node src/scripts/db-clear.ts",
    "config:check": "ts-node src/scripts/config-check.ts",
    "db:reset": "ts-node src/scripts/db-reset.ts",
    "settings:reencrypt": "ts-node src/scripts/reencrypt-settings.ts",
    "sms-credit:reconcile": "ts-node src/scripts/reconcile-sms-credit.ts",
    "backfill-trials": "ts-node src/scripts/backfill-trials.ts",
    "perf:attention": "ts-node src/scripts/perf-attention.ts",
    "predocs:generate": "yarn workspace @biddaloy/shared build",
    "docs:generate": "nest build && node dist/scripts/generate-openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@faker-js/faker": "^10",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12",
    "@nestjs/common": "^12",
    "@nestjs/config": "^12",
    "@nestjs/core": "^12",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12",
    "@sentry/node": "^10.74.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6",
    "class-transformer": "^0.5",
    "class-validator": "^0.15",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8",
    "pg-connection-string": "^2.14.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.5",
    "typeorm": "^0.3",
    "undici": "^8.10.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12",
    "@nestjs/testing": "^12",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5",
    "@types/multer": "^2.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/node": "^26",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6",
    "vitest": "^4"
  }
}
