{
  "name": "@biddaloy/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:unit:watch": "vitest --config vitest.unit.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:unit:changed": "vitest run --config vitest.unit.config.ts --changed origin/main",
    "test:integration": "vitest run 'integration.spec.ts' --reporter=verbose${CI_TIMINGS_OUT:+ --reporter=json --outputFile.json=$CI_TIMINGS_OUT}",
    "test:e2e": "vitest run 'e2e-spec.ts' --reporter=verbose${CI_TIMINGS_OUT:+ --reporter=json --outputFile.json=$CI_TIMINGS_OUT}",
    "test:file": "vitest run",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "db:clear": "ts-node src/scripts/db-clear.ts",
    "db:reset": "ts-node src/scripts/db-reset.ts",
    "settings:reencrypt": "ts-node src/scripts/reencrypt-settings.ts",
    "docs:generate": "nest build && node dist/scripts/generate-openapi.js"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11",
    "bcrypt": "^6.0.0",
    "bullmq": "^6",
    "class-transformer": "^0.5",
    "class-validator": "^0.15",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^6",
    "nodemailer": "^9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "typeorm": "^0.3",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5",
    "@types/multer": "^2.2.0",
    "@types/node": "^26",
    "@types/nodemailer": "^8",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6",
    "vitest": "^4"
  }
}
