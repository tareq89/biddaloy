{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["server"],
  "ignoreDependencies": [
    "@swc/core",
    "@types/bcrypt",
    "@types/supertest",
    "@vitest/coverage-v8",
    "supertest",
    "unplugin-swc"
  ],
  "ignoreIssues": {
    "ui/eslint-config.mjs": ["duplicates"],
    "ui/tailwind.preset.ts": ["duplicates"]
  },
  "workspaces": {
    "shared": {
      "project": ["src/**/*.ts"]
    },
    "ui": {
      "entry": ["src/primitives/**/*.{ts,tsx}", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "*.{ts,mjs}", "scripts/**/*.mjs", "eslint-rules/**/*.mjs"],
      "ignoreDependencies": ["@beton-boi/shared"]
    },
    "client-admin": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "client-student": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}"]
    }
  }
}
